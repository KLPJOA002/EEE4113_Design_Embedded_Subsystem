 662:Core/Src/main.c **** }
 663:Core/Src/main.c **** 
 664:Core/Src/main.c **** uint8_t LoRa_Detect(SX1278_t *module)
 665:Core/Src/main.c **** {
 666:Core/Src/main.c ****   uint8_t version = SX1278_SPIRead(module, REG_LR_VERSION);
 667:Core/Src/main.c ****   return (version == 0x12) ? 1 : 0;
 668:Core/Src/main.c **** }
 669:Core/Src/main.c **** 
 670:Core/Src/main.c **** 
 671:Core/Src/main.c **** 
 672:Core/Src/main.c **** uint8_t LoRa_TX(uint16_t message)
 673:Core/Src/main.c **** {
 674:Core/Src/main.c **** 
 675:Core/Src/main.c ****   //message_length = sprintf(Lora_buffer, "Hello May, Chamber ID:0001, DO: 21.5, RTD: 31.0, DO: 22.
 676:Core/Src/main.c ****   if (LoRa_Detect(&SX1278))
 677:Core/Src/main.c ****   {
 678:Core/Src/main.c ****     message_length = 2;
 679:Core/Src/main.c ****     ret = SX1278_LoRaEntryTx(&SX1278, message_length, 2000);
 680:Core/Src/main.c ****     if (ret)
 681:Core/Src/main.c ****     {
 682:Core/Src/main.c ****       ret = SX1278_LoRaTxPacket(&SX1278, (uint8_t*) &message, message_length, 2000);
 683:Core/Src/main.c ****       if(ret) return 1;
 684:Core/Src/main.c ****       else return 0;
 685:Core/Src/main.c ****     }
 686:Core/Src/main.c ****     else return 0;
 687:Core/Src/main.c ****   }
 688:Core/Src/main.c ****   else
 689:Core/Src/main.c ****   {
 690:Core/Src/main.c ****     LoRa_Connected = 0;
 691:Core/Src/main.c ****     return 0;
 692:Core/Src/main.c ****   }
 693:Core/Src/main.c **** }
 694:Core/Src/main.c **** 
 695:Core/Src/main.c **** void LoRa_RX()
 696:Core/Src/main.c **** {
 697:Core/Src/main.c ****   // Read packet out of the FIFO immediately
 698:Core/Src/main.c ****   LoRa_RX_Length = SX1278_LoRaRxPacket(&SX1278);
 699:Core/Src/main.c **** 
 700:Core/Src/main.c ****   if (LoRa_RX_Length > 0)
 701:Core/Src/main.c ****   {
 702:Core/Src/main.c ****       // Copy out of the module's internal buffer
 703:Core/Src/main.c ****       memcpy(LoRa_RX_Buffer, SX1278.rxBuffer, LoRa_RX_Length);
 704:Core/Src/main.c ****       LoRa_RX_Flag = 1;  // signal main loop to process it
 705:Core/Src/main.c ****   }
 706:Core/Src/main.c **** 
 707:Core/Src/main.c ****   // Re-arm the receiver for the next packet
 708:Core/Src/main.c ****   // Can't call SX1278_LoRaEntryRx here (it uses HAL_Delay)
 709:Core/Src/main.c ****   // Instead just reset the FIFO pointer and clear IRQ
 710:Core/Src/main.c ****   uint8_t addr = SX1278_SPIRead(&SX1278, LR_RegFifoRxBaseAddr);
 711:Core/Src/main.c ****   SX1278_SPIWrite(&SX1278, LR_RegFifoAddrPtr, addr);
 712:Core/Src/main.c ****   SX1278_clearLoRaIrq(&SX1278);
 713:Core/Src/main.c **** }
