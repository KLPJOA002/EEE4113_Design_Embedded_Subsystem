1395:Core/Src/main.c **** static void RTC_Set_Time_Once(I2C_HandleTypeDef *hi2c)
1396:Core/Src/main.c **** {
1397:Core/Src/main.c ****     // Check if time has already been set
1398:Core/Src/main.c ****     uint8_t magic = 0;
1399:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_MAGIC_REG, 1, &magic, 1, HAL_MAX_DELAY);
1400:Core/Src/main.c ****     
1401:Core/Src/main.c ****     if (magic == RTC_MAGIC_VAL)
1402:Core/Src/main.c ****         return; // Already set, skip
1403:Core/Src/main.c **** 
1404:Core/Src/main.c ****     // Parse compile-time strings into numbers
1405:Core/Src/main.c ****     // __DATE__ is "Mon DD YYYY" e.g. "Apr 22 2026"
1406:Core/Src/main.c ****     // __TIME__ is "HH:MM:SS"   e.g. "14:30:00"
1407:Core/Src/main.c ****     char date[] = __DATE__;
1408:Core/Src/main.c ****     char time[] = __TIME__;
1409:Core/Src/main.c **** 
1410:Core/Src/main.c ****     uint8_t day    = ((date[4] == ' ') ? 0 : (date[4] - '0')) * 10 + (date[5] - '0');
1411:Core/Src/main.c ****     uint16_t year  = (date[7]-'0')*1000 + (date[8]-'0')*100 + (date[9]-'0')*10 + (date[10]-'0');
1412:Core/Src/main.c ****     uint8_t hour   = (time[0]-'0')*10 + (time[1]-'0');
1413:Core/Src/main.c ****     uint8_t minute = (time[3]-'0')*10 + (time[4]-'0');
1414:Core/Src/main.c ****     uint8_t second = (time[6]-'0')*10 + (time[7]-'0');
1415:Core/Src/main.c **** 
1416:Core/Src/main.c ****     // Parse month string
1417:Core/Src/main.c ****     const char *months = "JanFebMarAprMayJunJulAugSepOctNovDec";
1418:Core/Src/main.c ****     uint8_t month = 1;
1419:Core/Src/main.c ****     for (int i = 0; i < 12; i++) {
1420:Core/Src/main.c ****         if (strncmp(&months[i*3], date, 3) == 0) {
1421:Core/Src/main.c ****             month = i + 1;
1422:Core/Src/main.c ****             break;
1423:Core/Src/main.c ****         }
1424:Core/Src/main.c ****     }
1425:Core/Src/main.c **** 
1426:Core/Src/main.c ****     // Write to DS3231 registers in BCD
1427:Core/Src/main.c ****     uint8_t reg_val;
1428:Core/Src/main.c **** 
1429:Core/Src/main.c ****     reg_val = decimalbcd(second);
1430:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Second, 1, &reg_val, 1, HAL_MAX_DELAY);
1431:Core/Src/main.c **** 
1432:Core/Src/main.c ****     reg_val = decimalbcd(minute);
1433:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Minute, 1, &reg_val, 1, HAL_MAX_DELAY);
1434:Core/Src/main.c **** 
1435:Core/Src/main.c ****     reg_val = decimalbcd(hour);
1436:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Hour, 1, &reg_val, 1, HAL_MAX_DELAY);
1437:Core/Src/main.c **** 
1438:Core/Src/main.c ****     reg_val = decimalbcd(day);
1439:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Day, 1, &reg_val, 1, HAL_MAX_DELAY);
1440:Core/Src/main.c **** 
1441:Core/Src/main.c ****     reg_val = decimalbcd(month);
1442:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Month, 1, &reg_val, 1, HAL_MAX_DELAY);
1443:Core/Src/main.c **** 
1444:Core/Src/main.c ****     reg_val = decimalbcd(year % 100); // DS3231 only stores last 2 digits
1445:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Year, 1, &reg_val, 1, HAL_MAX_DELAY);
1446:Core/Src/main.c **** 
1447:Core/Src/main.c ****     // Write magic flag so we never set time again
1448:Core/Src/main.c ****     reg_val = RTC_MAGIC_VAL;
1449:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_MAGIC_REG, 1, &reg_val, 1, HAL_MAX_DELAY);
1450:Core/Src/main.c **** }
