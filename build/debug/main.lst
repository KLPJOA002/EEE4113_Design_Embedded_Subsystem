 893:Core/Src/main.c ****     // Mask status bits BEFORE BCD conversion
 894:Core/Src/main.c ****     Year   = bcdtodec(Year);
 895:Core/Src/main.c ****     Month  = bcdtodec(Month  & 0x1F); // mask century bit
 896:Core/Src/main.c ****     Day    = bcdtodec(Day    & 0x3F);
 897:Core/Src/main.c ****     Hour   = bcdtodec(Hour   & 0x3F); // mask 12/24hr bit
 898:Core/Src/main.c ****     Minute = bcdtodec(Minute & 0x7F);
 899:Core/Src/main.c ****     Second = bcdtodec(Second & 0x7F);
 900:Core/Src/main.c **** 
 901:Core/Src/main.c ****     return get_unix_timestamp(2000 + Year, Month, Day, Hour, Minute, Second);
 902:Core/Src/main.c **** }
