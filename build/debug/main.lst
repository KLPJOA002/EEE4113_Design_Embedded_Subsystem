1684:Core/Src/main.c **** 
1685:Core/Src/main.c ****     // Standard C struct tm requirements:
1686:Core/Src/main.c ****     t.tm_year = year - 1900;  // Year since 1900
1687:Core/Src/main.c ****     t.tm_mon = month - 1;     // Month, 0 - 11
1688:Core/Src/main.c ****     t.tm_mday = day;          // Day of the month
1689:Core/Src/main.c ****     t.tm_hour = hour;
