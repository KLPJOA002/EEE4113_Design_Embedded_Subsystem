1756:Core/Src/main.c **** static uint32_t RTC_Get_Time(I2C_HandleTypeDef *hi2c)
1757:Core/Src/main.c **** {
1758:Core/Src/main.c ****     uint8_t Year, Month, Day, Hour, Minute, Second;
1759:Core/Src/main.c ****     const uint32_t timeout = 50;
1760:Core/Src/main.c **** 
1761:Core/Src/main.c ****     if (HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Year,   1, &Year,   1, timeout) != HAL_OK) return 0;
1762:Core/Src/main.c ****     if (HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Month,  1, &Month,  1, timeout) != HAL_OK) return 0;
1763:Core/Src/main.c ****     if (HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Day,    1, &Day,    1, timeout) != HAL_OK) return 0;
1764:Core/Src/main.c ****     if (HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Hour,   1, &Hour,   1, timeout) != HAL_OK) return 0;
1765:Core/Src/main.c ****     if (HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Minute, 1, &Minute, 1, timeout) != HAL_OK) return 0;
1766:Core/Src/main.c ****     if (HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Second, 1, &Second, 1, timeout) != HAL_OK) return 0;
1767:Core/Src/main.c **** 
1768:Core/Src/main.c ****     // Mask status bits BEFORE BCD conversion
1769:Core/Src/main.c ****     Year   = bcdtodec(Year);
1770:Core/Src/main.c ****     Month  = bcdtodec(Month  & 0x1F); // mask century bit
1771:Core/Src/main.c ****     Day    = bcdtodec(Day    & 0x3F);
1772:Core/Src/main.c ****     Hour   = bcdtodec(Hour   & 0x3F); // mask 12/24hr bit
1773:Core/Src/main.c ****     Minute = bcdtodec(Minute & 0x7F);
1774:Core/Src/main.c ****     Second = bcdtodec(Second & 0x7F);
1775:Core/Src/main.c **** 
1776:Core/Src/main.c ****     return get_unix_timestamp(2000 + Year, Month, Day, Hour, Minute, Second);
1777:Core/Src/main.c **** }
