1568:Core/Src/main.c **** 
1569:Core/Src/main.c **** static uint32_t RTC_Get_Time(I2C_HandleTypeDef *hi2c)
1570:Core/Src/main.c **** {
1571:Core/Src/main.c ****     uint8_t Year, Month, Day, Hour, Minute, Second;
1572:Core/Src/main.c **** 
1573:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Year,   1, &Year,   1, HAL_MAX_DELAY);
1574:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Month,  1, &Month,  1, HAL_MAX_DELAY);
1575:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Day,    1, &Day,    1, HAL_MAX_DELAY);
1576:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Hour,   1, &Hour,   1, HAL_MAX_DELAY);
1577:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Minute, 1, &Minute, 1, HAL_MAX_DELAY);
1578:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Second, 1, &Second, 1, HAL_MAX_DELAY);
1579:Core/Src/main.c **** 
1580:Core/Src/main.c ****     // Mask status bits BEFORE BCD conversion
1581:Core/Src/main.c ****     Year   = bcdtodec(Year);
1582:Core/Src/main.c ****     Month  = bcdtodec(Month  & 0x1F); // mask century bit
1583:Core/Src/main.c ****     Day    = bcdtodec(Day    & 0x3F);
1584:Core/Src/main.c ****     Hour   = bcdtodec(Hour   & 0x3F); // mask 12/24hr bit
1585:Core/Src/main.c ****     Minute = bcdtodec(Minute & 0x7F);
1586:Core/Src/main.c ****     Second = bcdtodec(Second & 0x7F);
1587:Core/Src/main.c **** 
1588:Core/Src/main.c ****     return get_unix_timestamp(2000 + Year, Month, Day, Hour, Minute, Second);
1589:Core/Src/main.c **** }
1590:Core/Src/main.c **** 
1591:Core/Src/main.c **** static void RTC_Set_Time_Once(I2C_HandleTypeDef *hi2c)
1592:Core/Src/main.c **** {
1593:Core/Src/main.c ****     // Check if time has already been set
1594:Core/Src/main.c ****     uint8_t magic = 0;
1595:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_MAGIC_REG, 1, &magic, 1, HAL_MAX_DELAY);
1596:Core/Src/main.c ****     
1597:Core/Src/main.c ****     if (magic == RTC_MAGIC_VAL)
1598:Core/Src/main.c ****         return; // Already set, skip
1599:Core/Src/main.c **** 
1600:Core/Src/main.c ****     // Parse compile-time strings into numbers
1601:Core/Src/main.c ****     // __DATE__ is "Mon DD YYYY" e.g. "Apr 22 2026"
1602:Core/Src/main.c ****     // __TIME__ is "HH:MM:SS"   e.g. "14:30:00"
1603:Core/Src/main.c ****     char date[] = __DATE__;
1604:Core/Src/main.c ****     char time[] = __TIME__;
1605:Core/Src/main.c **** 
1606:Core/Src/main.c ****     uint8_t day    = ((date[4] == ' ') ? 0 : (date[4] - '0')) * 10 + (date[5] - '0');
1607:Core/Src/main.c ****     uint16_t year  = (date[7]-'0')*1000 + (date[8]-'0')*100 + (date[9]-'0')*10 + (date[10]-'0');
1608:Core/Src/main.c ****     uint8_t hour   = (time[0]-'0')*10 + (time[1]-'0');
1609:Core/Src/main.c ****     uint8_t minute = (time[3]-'0')*10 + (time[4]-'0');
1610:Core/Src/main.c ****     uint8_t second = (time[6]-'0')*10 + (time[7]-'0');
1611:Core/Src/main.c **** 
1612:Core/Src/main.c ****     // Parse month string
1613:Core/Src/main.c ****     const char *months = "JanFebMarAprMayJunJulAugSepOctNovDec";
1614:Core/Src/main.c ****     uint8_t month = 1;
1615:Core/Src/main.c ****     for (int i = 0; i < 12; i++) {
1616:Core/Src/main.c ****         if (strncmp(&months[i*3], date, 3) == 0) {
1617:Core/Src/main.c ****             month = i + 1;
