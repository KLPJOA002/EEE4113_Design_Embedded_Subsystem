1703:Core/Src/main.c **** static uint32_t RTC_Get_Time(I2C_HandleTypeDef *hi2c)
1704:Core/Src/main.c **** {
1705:Core/Src/main.c ****     uint8_t Year, Month, Day, Hour, Minute, Second;
1706:Core/Src/main.c ****     const uint32_t timeout = 50;
1707:Core/Src/main.c **** 
1708:Core/Src/main.c ****     if (HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Year,   1, &Year,   1, timeout) != HAL_OK) return 0;
1709:Core/Src/main.c ****     if (HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Month,  1, &Month,  1, timeout) != HAL_OK) return 0;
1710:Core/Src/main.c ****     if (HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Day,    1, &Day,    1, timeout) != HAL_OK) return 0;
1711:Core/Src/main.c ****     if (HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Hour,   1, &Hour,   1, timeout) != HAL_OK) return 0;
1712:Core/Src/main.c ****     if (HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Minute, 1, &Minute, 1, timeout) != HAL_OK) return 0;
1713:Core/Src/main.c ****     if (HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Second, 1, &Second, 1, timeout) != HAL_OK) return 0;
1714:Core/Src/main.c **** 
1715:Core/Src/main.c ****     // Mask status bits BEFORE BCD conversion
1716:Core/Src/main.c ****     Year   = bcdtodec(Year);
1717:Core/Src/main.c ****     Month  = bcdtodec(Month  & 0x1F); // mask century bit
1718:Core/Src/main.c ****     Day    = bcdtodec(Day    & 0x3F);
1719:Core/Src/main.c ****     Hour   = bcdtodec(Hour   & 0x3F); // mask 12/24hr bit
1720:Core/Src/main.c ****     Minute = bcdtodec(Minute & 0x7F);
1721:Core/Src/main.c ****     Second = bcdtodec(Second & 0x7F);
1722:Core/Src/main.c **** 
1723:Core/Src/main.c ****     return get_unix_timestamp(2000 + Year, Month, Day, Hour, Minute, Second);
1724:Core/Src/main.c **** }
1725:Core/Src/main.c **** 
1726:Core/Src/main.c **** static void RTC_Set_Time_Once(I2C_HandleTypeDef *hi2c)
1727:Core/Src/main.c **** {
ARM GAS  C:\Users\joabk\AppData\Local\Temp\ccXjfbzk.s 			page 41


1728:Core/Src/main.c ****     // Check if time has already been set
1729:Core/Src/main.c ****     uint8_t magic = 0;
1730:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_MAGIC_REG, 1, &magic, 1, HAL_MAX_DELAY);
1731:Core/Src/main.c ****     
1732:Core/Src/main.c ****     if (magic == RTC_MAGIC_VAL)
1733:Core/Src/main.c ****         return; // Already set, skip
1734:Core/Src/main.c **** 
1735:Core/Src/main.c ****     // Parse compile-time strings into numbers
1736:Core/Src/main.c ****     // __DATE__ is "Mon DD YYYY" e.g. "Apr 22 2026"
1737:Core/Src/main.c ****     // __TIME__ is "HH:MM:SS"   e.g. "14:30:00"
1738:Core/Src/main.c ****     char date[] = __DATE__;
1739:Core/Src/main.c ****     char time[] = __TIME__;
1740:Core/Src/main.c **** 
1741:Core/Src/main.c ****     uint8_t day    = ((date[4] == ' ') ? 0 : (date[4] - '0')) * 10 + (date[5] - '0');
1742:Core/Src/main.c ****     uint16_t year  = (date[7]-'0')*1000 + (date[8]-'0')*100 + (date[9]-'0')*10 + (date[10]-'0');
1743:Core/Src/main.c ****     uint8_t hour   = (time[0]-'0')*10 + (time[1]-'0');
1744:Core/Src/main.c ****     uint8_t minute = (time[3]-'0')*10 + (time[4]-'0');
1745:Core/Src/main.c ****     uint8_t second = (time[6]-'0')*10 + (time[7]-'0');
1746:Core/Src/main.c **** 
1747:Core/Src/main.c ****     // Parse month string
1748:Core/Src/main.c ****     const char *months = "JanFebMarAprMayJunJulAugSepOctNovDec";
1749:Core/Src/main.c ****     uint8_t month = 1;
1750:Core/Src/main.c ****     for (int i = 0; i < 12; i++) {
1751:Core/Src/main.c ****         if (strncmp(&months[i*3], date, 3) == 0) {
1752:Core/Src/main.c ****             month = i + 1;
1753:Core/Src/main.c ****             break;
1754:Core/Src/main.c ****         }
1755:Core/Src/main.c ****     }
1756:Core/Src/main.c **** 
1757:Core/Src/main.c ****     // Write to DS3231 registers in BCD
1758:Core/Src/main.c ****     uint8_t reg_val;
1759:Core/Src/main.c **** 
1760:Core/Src/main.c ****     reg_val = decimalbcd(second);
1761:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Second, 1, &reg_val, 1, HAL_MAX_DELAY);
1762:Core/Src/main.c **** 
1763:Core/Src/main.c ****     reg_val = decimalbcd(minute);
1764:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Minute, 1, &reg_val, 1, HAL_MAX_DELAY);
1765:Core/Src/main.c **** 
1766:Core/Src/main.c ****     reg_val = decimalbcd(hour);
1767:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Hour, 1, &reg_val, 1, HAL_MAX_DELAY);
1768:Core/Src/main.c **** 
1769:Core/Src/main.c ****     reg_val = decimalbcd(day);
1770:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Day, 1, &reg_val, 1, HAL_MAX_DELAY);
1771:Core/Src/main.c **** 
1772:Core/Src/main.c ****     reg_val = decimalbcd(month);
1773:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Month, 1, &reg_val, 1, HAL_MAX_DELAY);
1774:Core/Src/main.c **** 
1775:Core/Src/main.c ****     reg_val = decimalbcd(year % 100); // DS3231 only stores last 2 digits
1776:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Year, 1, &reg_val, 1, HAL_MAX_DELAY);
1777:Core/Src/main.c **** 
1778:Core/Src/main.c ****     // Write magic flag so we never set time again
1779:Core/Src/main.c ****     reg_val = RTC_MAGIC_VAL;
1780:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_MAGIC_REG, 1, &reg_val, 1, HAL_MAX_DELAY);
1781:Core/Src/main.c **** }
