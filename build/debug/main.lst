1873:Core/Src/main.c **** static uint32_t get_unix_timestamp(uint16_t year, uint8_t month, uint8_t day, uint8_t hour, uint8_t
1874:Core/Src/main.c **** {
1875:Core/Src/main.c ****     struct tm t;
1876:Core/Src/main.c ****     time_t t_of_day;
1877:Core/Src/main.c **** 
1878:Core/Src/main.c ****     // Standard C struct tm requirements:
1879:Core/Src/main.c ****     t.tm_year = year - 1900;  // Year since 1900
1880:Core/Src/main.c ****     t.tm_mon = month - 1;     // Month, 0 - 11
1881:Core/Src/main.c ****     t.tm_mday = day;          // Day of the month
1882:Core/Src/main.c ****     t.tm_hour = hour;
1883:Core/Src/main.c ****     t.tm_min = min;
1884:Core/Src/main.c ****     t.tm_sec = sec;
1885:Core/Src/main.c ****     t.tm_isdst = -1;          // Is Daylight Savings Time on? -1 = let the library decide
1886:Core/Src/main.c **** 
1887:Core/Src/main.c ****     t_of_day = mktime(&t);
1888:Core/Src/main.c **** 
1889:Core/Src/main.c ****     return (uint32_t)t_of_day;
1890:Core/Src/main.c **** }
