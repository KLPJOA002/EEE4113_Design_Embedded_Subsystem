1254:Core/Src/main.c **** static void RTC_Set_Time_Once(I2C_HandleTypeDef *hi2c)
1255:Core/Src/main.c **** {
1256:Core/Src/main.c ****     // Check if time has already been set
1257:Core/Src/main.c ****     uint8_t magic = 0;
1258:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_MAGIC_REG, 1, &magic, 1, HAL_MAX_DELAY);
1259:Core/Src/main.c ****     
1260:Core/Src/main.c ****     if (magic == RTC_MAGIC_VAL)
1261:Core/Src/main.c ****         return; // Already set, skip
1262:Core/Src/main.c **** 
1263:Core/Src/main.c ****     // Parse compile-time strings into numbers
1264:Core/Src/main.c ****     // __DATE__ is "Mon DD YYYY" e.g. "Apr 22 2026"
1265:Core/Src/main.c ****     // __TIME__ is "HH:MM:SS"   e.g. "14:30:00"
1266:Core/Src/main.c ****     char date[] = __DATE__;
1267:Core/Src/main.c ****     char time[] = __TIME__;
1268:Core/Src/main.c **** 
1269:Core/Src/main.c ****     uint8_t day    = ((date[4] == ' ') ? 0 : (date[4] - '0')) * 10 + (date[5] - '0');
1270:Core/Src/main.c ****     uint16_t year  = (date[7]-'0')*1000 + (date[8]-'0')*100 + (date[9]-'0')*10 + (date[10]-'0');
1271:Core/Src/main.c ****     uint8_t hour   = (time[0]-'0')*10 + (time[1]-'0');
1272:Core/Src/main.c ****     uint8_t minute = (time[3]-'0')*10 + (time[4]-'0');
1273:Core/Src/main.c ****     uint8_t second = (time[6]-'0')*10 + (time[7]-'0');
1274:Core/Src/main.c **** 
1275:Core/Src/main.c ****     // Parse month string
1276:Core/Src/main.c ****     const char *months = "JanFebMarAprMayJunJulAugSepOctNovDec";
1277:Core/Src/main.c ****     uint8_t month = 1;
1278:Core/Src/main.c ****     for (int i = 0; i < 12; i++) {
1279:Core/Src/main.c ****         if (strncmp(&months[i*3], date, 3) == 0) {
1280:Core/Src/main.c ****             month = i + 1;
1281:Core/Src/main.c ****             break;
1282:Core/Src/main.c ****         }
1283:Core/Src/main.c ****     }
1284:Core/Src/main.c **** 
1285:Core/Src/main.c ****     // Write to DS3231 registers in BCD
1286:Core/Src/main.c ****     uint8_t reg_val;
1287:Core/Src/main.c **** 
1288:Core/Src/main.c ****     reg_val = decimalbcd(second);
1289:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Second, 1, &reg_val, 1, HAL_MAX_DELAY);
1290:Core/Src/main.c **** 
1291:Core/Src/main.c ****     reg_val = decimalbcd(minute);
