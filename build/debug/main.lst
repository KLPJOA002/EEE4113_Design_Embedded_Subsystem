1276:Core/Src/main.c **** 
1277:Core/Src/main.c ****     uint8_t addr = SX1278_SPIRead(&SX1278, LR_RegFifoTxBaseAddr);
1278:Core/Src/main.c ****     SX1278_SPIWrite(&SX1278, LR_RegFifoAddrPtr, addr);
1279:Core/Src/main.c **** 
1280:Core/Src/main.c ****     SX1278.status = TX;  // set before firing so EXTI handler ignores DIO0
1281:Core/Src/main.c **** 
1282:Core/Src/main.c ****     // Write payload and fire
1283:Core/Src/main.c ****     SX1278_SPIBurstWrite(&SX1278, 0x00, (uint8_t*)message, msg_len);
1284:Core/Src/main.c ****     SX1278_SPIWrite(&SX1278, LR_RegOpMode, 0x8B);  // TX mode
