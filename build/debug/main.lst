1287:Core/Src/main.c ****     SX1278_SPIWrite(&SX1278, LR_RegOpMode, 0x89);  // back to LoRa standby
1288:Core/Src/main.c ****     SX1278.status = STANDBY;
1289:Core/Src/main.c **** 
1290:Core/Src/main.c ****     return 1;
1291:Core/Src/main.c **** }
