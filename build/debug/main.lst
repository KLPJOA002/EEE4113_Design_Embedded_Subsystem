1573:Core/Src/main.c **** static uint8_t SD_DataDump(void)
1574:Core/Src/main.c **** {
1575:Core/Src/main.c ****     if (!SD_Connected) return 0;
1576:Core/Src/main.c **** 
1577:Core/Src/main.c ****     FATFS   FatFs;
1578:Core/Src/main.c ****     DIR     dir;
1579:Core/Src/main.c ****     FILINFO fno;
1580:Core/Src/main.c ****     FIL     fil;
1581:Core/Src/main.c ****     FRESULT fres;
1582:Core/Src/main.c **** 
1583:Core/Src/main.c ****     fres = f_mount(&FatFs, "", 1);
1584:Core/Src/main.c ****     if (fres != FR_OK) return 0;
1585:Core/Src/main.c **** 
1586:Core/Src/main.c ****     fres = f_opendir(&dir, "/");
1587:Core/Src/main.c ****     if (fres != FR_OK) { f_mount(NULL, "", 0); return 0; }
1588:Core/Src/main.c **** 
1589:Core/Src/main.c ****     uint16_t count = 0;
1590:Core/Src/main.c ****     char tx_buf[100];
1591:Core/Src/main.c **** 
1592:Core/Src/main.c ****     while (1)
1593:Core/Src/main.c ****     {
1594:Core/Src/main.c ****         fres = f_readdir(&dir, &fno);
1595:Core/Src/main.c ****         // End of directory or error
1596:Core/Src/main.c ****         if (fres != FR_OK || fno.fname[0] == '\0') break;
1597:Core/Src/main.c ****         // Skip directories and non-CSV files
1598:Core/Src/main.c ****         if (fno.fattrib & AM_DIR) continue;
1599:Core/Src/main.c ****         if (strstr(fno.fname, "READING.CSV") == NULL) continue;
1600:Core/Src/main.c **** 
1601:Core/Src/main.c ****         // Open the file
1602:Core/Src/main.c ****         fres = f_open(&fil, fno.fname, FA_READ);
1603:Core/Src/main.c ****         if (fres != FR_OK) continue;
1604:Core/Src/main.c **** 
1605:Core/Src/main.c ****         // --- Parse the CSV ---
1606:Core/Src/main.c ****         // File format (after header):
1607:Core/Src/main.c ****         //   2025-05-10 12:30:00,DO_1,8.45
1608:Core/Src/main.c ****         //   2025-05-10 12:30:00,RTD_1,22.1
1609:Core/Src/main.c ****         //   2025-05-10 12:30:00,DO_2,7.90
1610:Core/Src/main.c ****         //   2025-05-10 12:30:00,RTD_2,21.5
1611:Core/Src/main.c **** 
1612:Core/Src/main.c ****         char line[60];
1613:Core/Src/main.c ****         char ts[20]   = "";
1614:Core/Src/main.c ****         char do1[16]  = "";
1615:Core/Src/main.c ****         char rtd1[16] = "";
1616:Core/Src/main.c ****         char do2[16]  = "";
1617:Core/Src/main.c ****         char rtd2[16] = "";
1618:Core/Src/main.c **** 
1619:Core/Src/main.c ****         // Skip header line
1620:Core/Src/main.c ****         f_gets(line, sizeof(line), &fil);
1621:Core/Src/main.c **** 
1622:Core/Src/main.c ****         // Read the 4 data lines
1623:Core/Src/main.c ****         while (f_gets(line, sizeof(line), &fil))
1624:Core/Src/main.c ****         {
1625:Core/Src/main.c ****             // Remove trailing newline
1626:Core/Src/main.c ****             line[strcspn(line, "\r\n")] = '\0';
ARM GAS  C:\Users\joabk\AppData\Local\Temp\ccXjfbzk.s 			page 30


1627:Core/Src/main.c **** 
1628:Core/Src/main.c ****             // Split: "YYYY-MM-DD HH:MM:SS,SENSOR,VALUE"
1629:Core/Src/main.c ****             char *col1 = strtok(line, ",");   // timestamp
1630:Core/Src/main.c ****             char *col2 = strtok(NULL, ",");   // sensor name
1631:Core/Src/main.c ****             char *col3 = strtok(NULL, ",");   // value
1632:Core/Src/main.c **** 
1633:Core/Src/main.c ****             if (!col1 || !col2 || !col3) continue;
1634:Core/Src/main.c **** 
1635:Core/Src/main.c ****             // Capture timestamp from first row (all rows share same timestamp)
1636:Core/Src/main.c ****             if (ts[0] == '\0') strncpy(ts, col1, sizeof(ts)-1);
1637:Core/Src/main.c **** 
1638:Core/Src/main.c ****             if      (strcmp(col2, "DO_1")  == 0) strncpy(do1,  col3, sizeof(do1)-1);
1639:Core/Src/main.c ****             else if (strcmp(col2, "RTD_1") == 0) strncpy(rtd1, col3, sizeof(rtd1)-1);
1640:Core/Src/main.c ****             else if (strcmp(col2, "DO_2")  == 0) strncpy(do2,  col3, sizeof(do2)-1);
1641:Core/Src/main.c ****             else if (strcmp(col2, "RTD_2") == 0) strncpy(rtd2, col3, sizeof(rtd2)-1);
1642:Core/Src/main.c ****         }
1643:Core/Src/main.c **** 
1644:Core/Src/main.c ****         f_close(&fil);
1645:Core/Src/main.c **** 
1646:Core/Src/main.c ****         // Convert timestamp "YYYY-MM-DD HH:MM:SS" → "YYYY_MM_DD_HH_MM_SS"
1647:Core/Src/main.c ****         // Replace spaces, dashes, colons with underscores
1648:Core/Src/main.c ****         char ts_fmt[20] = "";
1649:Core/Src/main.c ****         strncpy(ts_fmt, ts, sizeof(ts_fmt)-1);
1650:Core/Src/main.c ****         for (int i = 0; ts_fmt[i]; i++) {
1651:Core/Src/main.c ****             if (ts_fmt[i] == ' ' || ts_fmt[i] == '-' || ts_fmt[i] == ':')
1652:Core/Src/main.c ****                 ts_fmt[i] = '_';
1653:Core/Src/main.c ****         }
1654:Core/Src/main.c **** 
1655:Core/Src/main.c ****         // Transmit Chamber 0 (DO_1 / RTD_1)
1656:Core/Src/main.c ****         snprintf(tx_buf, sizeof(tx_buf),
1657:Core/Src/main.c ****                  "TYPE:2,BUOY:0,CHAMBER:0,DO:%s,RTD:%s,TS:%s",
1658:Core/Src/main.c ****                  do1, rtd1, ts_fmt);
1659:Core/Src/main.c ****         LoRa_TX_Continuous(tx_buf);
1660:Core/Src/main.c **** 
1661:Core/Src/main.c ****         // Transmit Chamber 1 (DO_2 / RTD_2)
1662:Core/Src/main.c ****         snprintf(tx_buf, sizeof(tx_buf),
1663:Core/Src/main.c ****                  "TYPE:2,BUOY:0,CHAMBER:1,DO:%s,RTD:%s,TS:%s",
1664:Core/Src/main.c ****                  do2, rtd2, ts_fmt);
1665:Core/Src/main.c ****         LoRa_TX_Continuous(tx_buf);
1666:Core/Src/main.c **** 
1667:Core/Src/main.c ****         count++;
1668:Core/Src/main.c ****     }
1669:Core/Src/main.c **** 
1670:Core/Src/main.c ****     f_closedir(&dir);
1671:Core/Src/main.c ****     f_mount(NULL, "", 0);
1672:Core/Src/main.c **** 
1673:Core/Src/main.c ****     // Send the end-of-dump summary (count = number of readings, not packets)
1674:Core/Src/main.c ****     snprintf(tx_buf, sizeof(tx_buf), "TYPE:4,BUOY:0,COUNT:%u", count);
1675:Core/Src/main.c ****     LoRa_TX(tx_buf);
1676:Core/Src/main.c **** 
1677:Core/Src/main.c ****     return count;
1678:Core/Src/main.c **** }
1679:Core/Src/main.c **** 
