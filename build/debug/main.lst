 660:Core/Src/main.c **** uint8_t LoRa_Init()
 661:Core/Src/main.c **** {
 662:Core/Src/main.c **** 
 663:Core/Src/main.c ****   SX1278_hw_init(&SX1278_hw);
 664:Core/Src/main.c **** 
 665:Core/Src/main.c ****   // Step 2: perform a hard reset and wait for module to boot
 666:Core/Src/main.c ****   SX1278_hw_Reset(&SX1278_hw);   // pulls reset low then high, waits 100ms internally
 667:Core/Src/main.c ****   HAL_Delay(100);
 668:Core/Src/main.c ****   if (LoRa_Detect(&SX1278))
 669:Core/Src/main.c ****   {
 670:Core/Src/main.c ****     SX1278_init(&SX1278, 433175000, SX1278_POWER_11DBM, SX1278_LORA_SF_7,
 671:Core/Src/main.c ****     SX1278_LORA_BW_125KHZ, SX1278_LORA_CR_4_5, SX1278_LORA_CRC_EN, 100);
 672:Core/Src/main.c **** 
 673:Core/Src/main.c ****     LoRa_Connected = 1;
 674:Core/Src/main.c ****     return 1;
 675:Core/Src/main.c ****   }
 676:Core/Src/main.c ****   else
 677:Core/Src/main.c ****   {
 678:Core/Src/main.c ****     LoRa_Connected = 0;
 679:Core/Src/main.c ****     return 0;
 680:Core/Src/main.c ****   }
 681:Core/Src/main.c **** }
 682:Core/Src/main.c **** 
 683:Core/Src/main.c **** uint8_t LoRa_Detect(SX1278_t *module)
 684:Core/Src/main.c **** {
 685:Core/Src/main.c ****   uint8_t version = SX1278_SPIRead(module, REG_LR_VERSION);
 686:Core/Src/main.c ****   return (version == 0x12) ? 1 : 0;
 687:Core/Src/main.c **** }
 688:Core/Src/main.c **** 
 689:Core/Src/main.c **** 
 690:Core/Src/main.c **** 
 691:Core/Src/main.c **** uint8_t LoRa_TX(char message[50])
 692:Core/Src/main.c **** {
 693:Core/Src/main.c ****   //message_length = sprintf(Lora_buffer, "Hello May, Chamber ID:0001, DO: 21.5, RTD: 31.0, DO: 22.
 694:Core/Src/main.c ****   message_length = sizeof(message);
 695:Core/Src/main.c ****   if (LoRa_Detect(&SX1278))
 696:Core/Src/main.c ****   {
 697:Core/Src/main.c ****     message_length = 2;
 698:Core/Src/main.c ****     ret = SX1278_LoRaEntryTx(&SX1278, message_length, 2000);
 699:Core/Src/main.c ****     if (ret)
 700:Core/Src/main.c ****     {
 701:Core/Src/main.c ****       ret = SX1278_LoRaTxPacket(&SX1278, (uint8_t*) &message, message_length, 2000);
 702:Core/Src/main.c ****       if(ret) return 1;
 703:Core/Src/main.c ****       else return 0;
 704:Core/Src/main.c ****     }
 705:Core/Src/main.c ****     else return 0;
 706:Core/Src/main.c ****   }
 707:Core/Src/main.c ****   else
 708:Core/Src/main.c ****   {
 709:Core/Src/main.c ****     LoRa_Connected = 0;
 710:Core/Src/main.c ****     return 0;
 711:Core/Src/main.c ****   }
 712:Core/Src/main.c **** }
 713:Core/Src/main.c **** 
 714:Core/Src/main.c **** void LoRa_RX()
ARM GAS  C:\Users\joabk\AppData\Local\Temp\ccd7gmxX.s 			page 14


 715:Core/Src/main.c **** {
 716:Core/Src/main.c ****   // Read packet out of the FIFO immediately
 717:Core/Src/main.c ****   LoRa_RX_Length = SX1278_LoRaRxPacket(&SX1278);
 718:Core/Src/main.c **** 
 719:Core/Src/main.c ****   if (LoRa_RX_Length > 0)
 720:Core/Src/main.c ****   {
 721:Core/Src/main.c ****       // Copy out of the module's internal buffer
 722:Core/Src/main.c ****       memcpy(LoRa_RX_Buffer, SX1278.rxBuffer, LoRa_RX_Length);
 723:Core/Src/main.c ****       LoRa_RX_Flag = 1;  // signal main loop to process it
 724:Core/Src/main.c ****   }
 725:Core/Src/main.c **** 
 726:Core/Src/main.c ****   // Re-arm the receiver for the next packet
 727:Core/Src/main.c ****   // Can't call SX1278_LoRaEntryRx here (it uses HAL_Delay)
 728:Core/Src/main.c ****   // Instead just reset the FIFO pointer and clear IRQ
 729:Core/Src/main.c ****   uint8_t addr = SX1278_SPIRead(&SX1278, LR_RegFifoRxBaseAddr);
 730:Core/Src/main.c ****   SX1278_SPIWrite(&SX1278, LR_RegFifoAddrPtr, addr);
 731:Core/Src/main.c ****   SX1278_clearLoRaIrq(&SX1278);
 732:Core/Src/main.c **** }
