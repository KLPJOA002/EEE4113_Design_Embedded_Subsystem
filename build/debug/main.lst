1657:Core/Src/main.c **** 
1658:Core/Src/main.c ****         // --- Parse the CSV ---
1659:Core/Src/main.c ****         // File format (after header):
1660:Core/Src/main.c ****         //   2025-05-10 12:30:00,DO_1,8.45
1661:Core/Src/main.c ****         //   2025-05-10 12:30:00,RTD_1,22.1
1662:Core/Src/main.c ****         //   2025-05-10 12:30:00,DO_2,7.90
1663:Core/Src/main.c ****         //   2025-05-10 12:30:00,RTD_2,21.5
1664:Core/Src/main.c **** 
1665:Core/Src/main.c ****         char line[60];
1666:Core/Src/main.c ****         char ts[20]   = "";
1667:Core/Src/main.c ****         char do1[16]  = "";
1668:Core/Src/main.c ****         char rtd1[16] = "";
1669:Core/Src/main.c ****         char do2[16]  = "";
1670:Core/Src/main.c ****         char rtd2[16] = "";
1671:Core/Src/main.c **** 
1672:Core/Src/main.c ****         // Skip header line
1673:Core/Src/main.c ****         f_gets(line, sizeof(line), &fil);
1674:Core/Src/main.c **** 
1675:Core/Src/main.c ****         // Read the 4 data lines
1676:Core/Src/main.c ****         while (f_gets(line, sizeof(line), &fil))
1677:Core/Src/main.c ****         {
1678:Core/Src/main.c ****             // Remove trailing newline
1679:Core/Src/main.c ****             line[strcspn(line, "\r\n")] = '\0';
1680:Core/Src/main.c **** 
1681:Core/Src/main.c ****             // Split: "YYYY-MM-DD HH:MM:SS,SENSOR,VALUE"
1682:Core/Src/main.c ****             char *col1 = strtok(line, ",");   // timestamp
1683:Core/Src/main.c ****             char *col2 = strtok(NULL, ",");   // sensor name
ARM GAS  C:\Users\joabk\AppData\Local\Temp\ccO7Rtya.s 			page 31


1684:Core/Src/main.c ****             char *col3 = strtok(NULL, ",");   // value
1685:Core/Src/main.c **** 
1686:Core/Src/main.c ****             if (!col1 || !col2 || !col3) continue;
1687:Core/Src/main.c **** 
1688:Core/Src/main.c ****             // Capture timestamp from first row (all rows share same timestamp)
1689:Core/Src/main.c ****             if (ts[0] == '\0') strncpy(ts, col1, sizeof(ts)-1);
1690:Core/Src/main.c **** 
1691:Core/Src/main.c ****             if      (strcmp(col2, "DO_1")  == 0) strncpy(do1,  col3, sizeof(do1)-1);
1692:Core/Src/main.c ****             else if (strcmp(col2, "RTD_1") == 0) strncpy(rtd1, col3, sizeof(rtd1)-1);
1693:Core/Src/main.c ****             else if (strcmp(col2, "DO_2")  == 0) strncpy(do2,  col3, sizeof(do2)-1);
1694:Core/Src/main.c ****             else if (strcmp(col2, "RTD_2") == 0) strncpy(rtd2, col3, sizeof(rtd2)-1);
1695:Core/Src/main.c ****         }
1696:Core/Src/main.c **** 
1697:Core/Src/main.c ****         f_close(&fil);
1698:Core/Src/main.c **** 
1699:Core/Src/main.c ****         // Convert timestamp "YYYY-MM-DD HH:MM:SS" → "YYYY_MM_DD_HH_MM_SS"
1700:Core/Src/main.c ****         // Replace spaces, dashes, colons with underscores
1701:Core/Src/main.c ****         char ts_fmt[20] = "";
1702:Core/Src/main.c ****         strncpy(ts_fmt, ts, sizeof(ts_fmt)-1);
1703:Core/Src/main.c ****         for (int i = 0; ts_fmt[i]; i++) {
1704:Core/Src/main.c ****             if (ts_fmt[i] == ' ' || ts_fmt[i] == '-' || ts_fmt[i] == ':')
