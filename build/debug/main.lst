 646:Core/Src/main.c **** 
 647:Core/Src/main.c ****     t_of_day = mktime(&t);
 648:Core/Src/main.c **** 
 649:Core/Src/main.c ****     return (uint32_t)t_of_day;
 650:Core/Src/main.c **** }
