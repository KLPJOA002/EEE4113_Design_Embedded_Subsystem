 671:Core/Src/main.c **** uint8_t LoRa_Init()
 672:Core/Src/main.c **** {
 673:Core/Src/main.c **** 
 674:Core/Src/main.c ****   SX1278_hw_init(&SX1278_hw);
 675:Core/Src/main.c **** 
 676:Core/Src/main.c ****   // Step 2: perform a hard reset and wait for module to boot
 677:Core/Src/main.c ****   SX1278_hw_Reset(&SX1278_hw);   // pulls reset low then high, waits 100ms internally
 678:Core/Src/main.c ****   HAL_Delay(100);
 679:Core/Src/main.c ****   if (LoRa_Detect(&SX1278))
 680:Core/Src/main.c ****   {
 681:Core/Src/main.c ****     SX1278_init(&SX1278, 433175000, SX1278_POWER_11DBM, SX1278_LORA_SF_7,
 682:Core/Src/main.c ****     SX1278_LORA_BW_125KHZ, SX1278_LORA_CR_4_5, SX1278_LORA_CRC_EN, 100);
 683:Core/Src/main.c **** 
 684:Core/Src/main.c ****     SX1278_LoRaEntryRx(&SX1278, 100, 2000);
 685:Core/Src/main.c **** 
 686:Core/Src/main.c ****     LoRa_Connected = 1;
 687:Core/Src/main.c ****     return 1;
 688:Core/Src/main.c ****   }
 689:Core/Src/main.c ****   else
 690:Core/Src/main.c ****   {
 691:Core/Src/main.c ****     LoRa_Connected = 0;
 692:Core/Src/main.c ****     return 0;
 693:Core/Src/main.c ****   }
 694:Core/Src/main.c **** }
 695:Core/Src/main.c **** 
 696:Core/Src/main.c **** uint8_t LoRa_Detect(SX1278_t *module)
 697:Core/Src/main.c **** {
 698:Core/Src/main.c ****   uint8_t version = SX1278_SPIRead(module, REG_LR_VERSION);
 699:Core/Src/main.c ****   return (version == 0x12) ? 1 : 0;
 700:Core/Src/main.c **** }
 701:Core/Src/main.c **** 
 702:Core/Src/main.c **** 
 703:Core/Src/main.c **** 
 704:Core/Src/main.c **** uint8_t LoRa_TX(char message[50])
 705:Core/Src/main.c **** {
 706:Core/Src/main.c ****   //message_length = sprintf(Lora_buffer, "Hello May, Chamber ID:0001, DO: 21.5, RTD: 31.0, DO: 22.
 707:Core/Src/main.c ****   message_length = strlen(message);
 708:Core/Src/main.c **** 
 709:Core/Src/main.c ****   if (message_length == 0 || message_length > 50)
 710:Core/Src/main.c ****     return 0;  // guard against empty or oversized messages
 711:Core/Src/main.c **** 
 712:Core/Src/main.c ****   if (LoRa_Detect(&SX1278))
 713:Core/Src/main.c ****   {
 714:Core/Src/main.c ****     ret = SX1278_LoRaEntryTx(&SX1278, message_length, 2000);
ARM GAS  C:\Users\joabk\AppData\Local\Temp\cccXr1OJ.s 			page 14


 715:Core/Src/main.c ****     if (ret)
 716:Core/Src/main.c ****     {
 717:Core/Src/main.c ****       ret = SX1278_LoRaTxPacket(&SX1278, (uint8_t*) message, message_length, 2000);
 718:Core/Src/main.c **** 
 719:Core/Src/main.c ****       SX1278_LoRaEntryRx(&SX1278, 100, 2000);
 720:Core/Src/main.c **** 
 721:Core/Src/main.c ****       if(ret) return 1;
 722:Core/Src/main.c ****       else return 0;
 723:Core/Src/main.c ****     }
 724:Core/Src/main.c ****     else return 0;
 725:Core/Src/main.c ****   }
 726:Core/Src/main.c ****   else
 727:Core/Src/main.c ****   {
 728:Core/Src/main.c ****     LoRa_Connected = 0;
 729:Core/Src/main.c ****     return 0;
 730:Core/Src/main.c ****   }
 731:Core/Src/main.c **** }
 732:Core/Src/main.c **** 
 733:Core/Src/main.c **** void LoRa_RX()
 734:Core/Src/main.c **** {
 735:Core/Src/main.c ****   // Read packet out of the FIFO immediately
 736:Core/Src/main.c ****   LoRa_RX_Length = SX1278_LoRaRxPacket(&SX1278);
 737:Core/Src/main.c **** 
 738:Core/Src/main.c ****   if (LoRa_RX_Length > 0)
