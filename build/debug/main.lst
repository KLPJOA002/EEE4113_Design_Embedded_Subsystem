1021:Core/Src/main.c **** 
1022:Core/Src/main.c ****     // Mask status bits BEFORE BCD conversion
1023:Core/Src/main.c ****     Year   = bcdtodec(Year);
1024:Core/Src/main.c ****     Month  = bcdtodec(Month  & 0x1F); // mask century bit
1025:Core/Src/main.c ****     Day    = bcdtodec(Day    & 0x3F);
1026:Core/Src/main.c ****     Hour   = bcdtodec(Hour   & 0x3F); // mask 12/24hr bit
1027:Core/Src/main.c ****     Minute = bcdtodec(Minute & 0x7F);
1028:Core/Src/main.c ****     Second = bcdtodec(Second & 0x7F);
1029:Core/Src/main.c **** 
1030:Core/Src/main.c ****     return get_unix_timestamp(2000 + Year, Month, Day, Hour, Minute, Second);
1031:Core/Src/main.c **** }
