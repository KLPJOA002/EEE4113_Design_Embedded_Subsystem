 657:Core/Src/main.c **** 
 658:Core/Src/main.c **** static uint32_t RTC_Get_Time(I2C_HandleTypeDef *hi2c)
 659:Core/Src/main.c **** {
 660:Core/Src/main.c ****     uint8_t Year, Month, Day, Hour, Minute, Second;
 661:Core/Src/main.c **** 
 662:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Year,   1, &Year,   1, HAL_MAX_DELAY);
 663:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Month,  1, &Month,  1, HAL_MAX_DELAY);
 664:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Day,    1, &Day,    1, HAL_MAX_DELAY);
 665:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Hour,   1, &Hour,   1, HAL_MAX_DELAY);
 666:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Minute, 1, &Minute, 1, HAL_MAX_DELAY);
 667:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Second, 1, &Second, 1, HAL_MAX_DELAY);
 668:Core/Src/main.c **** 
 669:Core/Src/main.c ****     // Mask status bits BEFORE BCD conversion
 670:Core/Src/main.c ****     Year   = bcdtodec(Year);
 671:Core/Src/main.c ****     Month  = bcdtodec(Month  & 0x1F); // mask century bit
ARM GAS  C:\Users\joabk\AppData\Local\Temp\cc25oJKz.s 			page 21


 672:Core/Src/main.c ****     Day    = bcdtodec(Day    & 0x3F);
 673:Core/Src/main.c ****     Hour   = bcdtodec(Hour   & 0x3F); // mask 12/24hr bit
 674:Core/Src/main.c ****     Minute = bcdtodec(Minute & 0x7F);
 675:Core/Src/main.c ****     Second = bcdtodec(Second & 0x7F);
 676:Core/Src/main.c **** 
 677:Core/Src/main.c ****     return get_unix_timestamp(2000 + Year, Month, Day, Hour, Minute, Second);
 678:Core/Src/main.c **** }
