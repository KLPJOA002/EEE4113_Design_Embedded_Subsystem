 960:Core/Src/main.c **** 
 961:Core/Src/main.c **** static uint32_t RTC_Get_Time(I2C_HandleTypeDef *hi2c)
 962:Core/Src/main.c **** {
 963:Core/Src/main.c ****     uint8_t Year, Month, Day, Hour, Minute, Second;
 964:Core/Src/main.c **** 
 965:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Year,   1, &Year,   1, HAL_MAX_DELAY);
 966:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Month,  1, &Month,  1, HAL_MAX_DELAY);
 967:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Day,    1, &Day,    1, HAL_MAX_DELAY);
 968:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Hour,   1, &Hour,   1, HAL_MAX_DELAY);
 969:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Minute, 1, &Minute, 1, HAL_MAX_DELAY);
 970:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Second, 1, &Second, 1, HAL_MAX_DELAY);
 971:Core/Src/main.c **** 
 972:Core/Src/main.c ****     // Mask status bits BEFORE BCD conversion
 973:Core/Src/main.c ****     Year   = bcdtodec(Year);
 974:Core/Src/main.c ****     Month  = bcdtodec(Month  & 0x1F); // mask century bit
 975:Core/Src/main.c ****     Day    = bcdtodec(Day    & 0x3F);
 976:Core/Src/main.c ****     Hour   = bcdtodec(Hour   & 0x3F); // mask 12/24hr bit
 977:Core/Src/main.c ****     Minute = bcdtodec(Minute & 0x7F);
 978:Core/Src/main.c ****     Second = bcdtodec(Second & 0x7F);
 979:Core/Src/main.c **** 
 980:Core/Src/main.c ****     return get_unix_timestamp(2000 + Year, Month, Day, Hour, Minute, Second);
 981:Core/Src/main.c **** }
 982:Core/Src/main.c **** 
 983:Core/Src/main.c **** static void RTC_Set_Time_Once(I2C_HandleTypeDef *hi2c)
 984:Core/Src/main.c **** {
