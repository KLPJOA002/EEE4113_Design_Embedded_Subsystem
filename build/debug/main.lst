1311:Core/Src/main.c **** static void RTC_Set_Time(I2C_HandleTypeDef *hi2c,char *Time)
1312:Core/Src/main.c **** {
1313:Core/Src/main.c ****     // __DATE__ is "YYYY:MM:DD:HH:MM:SS"
1314:Core/Src/main.c **** 
1315:Core/Src/main.c ****     uint16_t year = (Time[0]-'0')*1000 + (Time[1]-'0')*100 + (Time[2]-'0')*10 + (Time[3]-'0');
1316:Core/Src/main.c ****     uint8_t month = (Time[5]-'0')*10 + (Time[6]-'0');
1317:Core/Src/main.c ****     uint8_t day = (Time[8]-'0')*10 + (Time[9]-'0');
1318:Core/Src/main.c ****     uint8_t hour = (Time[11]-'0')*10 + (Time[12]-'0');
1319:Core/Src/main.c ****     uint8_t minute = (Time[14]-'0')*10 + (Time[15]-'0');
