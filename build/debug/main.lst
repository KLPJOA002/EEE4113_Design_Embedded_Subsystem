 685:Core/Src/main.c **** 
 686:Core/Src/main.c **** 
 687:Core/Src/main.c **** uint8_t LoRa_TX(uint16_t message)
 688:Core/Src/main.c **** {
 689:Core/Src/main.c **** 
 690:Core/Src/main.c ****   //message_length = sprintf(Lora_buffer, "Hello May, Chamber ID:0001, DO: 21.5, RTD: 31.0, DO: 22.
 691:Core/Src/main.c ****   if (LoRa_Detect(&SX1278))
 692:Core/Src/main.c ****   {
 693:Core/Src/main.c ****     message_length = 2;
 694:Core/Src/main.c ****     ret = SX1278_LoRaEntryTx(&SX1278, message_length, 2000);
 695:Core/Src/main.c ****     if (ret)
 696:Core/Src/main.c ****     {
 697:Core/Src/main.c ****       ret = SX1278_LoRaTxPacket(&SX1278, (uint8_t*) &message, message_length, 2000);
 698:Core/Src/main.c ****       if(ret) return 1;
 699:Core/Src/main.c ****       else return 0;
 700:Core/Src/main.c ****     }
 701:Core/Src/main.c ****     else return 0;
 702:Core/Src/main.c ****   }
 703:Core/Src/main.c ****   else
 704:Core/Src/main.c ****   {
 705:Core/Src/main.c ****     LoRa_Connected = 0;
 706:Core/Src/main.c ****     return 0;
 707:Core/Src/main.c ****   }
 708:Core/Src/main.c **** }
 709:Core/Src/main.c **** 
 710:Core/Src/main.c **** void LoRa_RX()
 711:Core/Src/main.c **** {
 712:Core/Src/main.c ****   // Read packet out of the FIFO immediately
 713:Core/Src/main.c ****   LoRa_RX_Length = SX1278_LoRaRxPacket(&SX1278);
 714:Core/Src/main.c **** 
ARM GAS  C:\Users\joabk\AppData\Local\Temp\cctqQB7T.s 			page 14


 715:Core/Src/main.c ****   if (LoRa_RX_Length > 0)
 716:Core/Src/main.c ****   {
 717:Core/Src/main.c ****       // Copy out of the module's internal buffer
 718:Core/Src/main.c ****       memcpy(LoRa_RX_Buffer, SX1278.rxBuffer, LoRa_RX_Length);
 719:Core/Src/main.c ****       LoRa_RX_Flag = 1;  // signal main loop to process it
 720:Core/Src/main.c ****   }
 721:Core/Src/main.c **** 
 722:Core/Src/main.c ****   // Re-arm the receiver for the next packet
 723:Core/Src/main.c ****   // Can't call SX1278_LoRaEntryRx here (it uses HAL_Delay)
 724:Core/Src/main.c ****   // Instead just reset the FIFO pointer and clear IRQ
 725:Core/Src/main.c ****   uint8_t addr = SX1278_SPIRead(&SX1278, LR_RegFifoRxBaseAddr);
 726:Core/Src/main.c ****   SX1278_SPIWrite(&SX1278, LR_RegFifoAddrPtr, addr);
 727:Core/Src/main.c ****   SX1278_clearLoRaIrq(&SX1278);
 728:Core/Src/main.c **** }
