 678:Core/Src/main.c **** 
 679:Core/Src/main.c **** uint8_t LoRa_Detect(SX1278_t *module)
 680:Core/Src/main.c **** {
 681:Core/Src/main.c ****   uint8_t version = SX1278_SPIRead(module, REG_LR_VERSION);
 682:Core/Src/main.c ****   return (version == 0x12) ? 1 : 0;
 683:Core/Src/main.c **** }
