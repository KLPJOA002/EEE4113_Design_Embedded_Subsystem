1232:Core/Src/main.c **** static uint32_t RTC_Get_Time(I2C_HandleTypeDef *hi2c)
1233:Core/Src/main.c **** {
1234:Core/Src/main.c ****     uint8_t Year, Month, Day, Hour, Minute, Second;
ARM GAS  C:\Users\joabk\AppData\Local\Temp\cc0QW1bx.s 			page 32


1235:Core/Src/main.c **** 
1236:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Year,   1, &Year,   1, HAL_MAX_DELAY);
1237:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Month,  1, &Month,  1, HAL_MAX_DELAY);
1238:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Day,    1, &Day,    1, HAL_MAX_DELAY);
1239:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Hour,   1, &Hour,   1, HAL_MAX_DELAY);
1240:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Minute, 1, &Minute, 1, HAL_MAX_DELAY);
1241:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Second, 1, &Second, 1, HAL_MAX_DELAY);
1242:Core/Src/main.c **** 
1243:Core/Src/main.c ****     // Mask status bits BEFORE BCD conversion
1244:Core/Src/main.c ****     Year   = bcdtodec(Year);
1245:Core/Src/main.c ****     Month  = bcdtodec(Month  & 0x1F); // mask century bit
1246:Core/Src/main.c ****     Day    = bcdtodec(Day    & 0x3F);
1247:Core/Src/main.c ****     Hour   = bcdtodec(Hour   & 0x3F); // mask 12/24hr bit
1248:Core/Src/main.c ****     Minute = bcdtodec(Minute & 0x7F);
1249:Core/Src/main.c ****     Second = bcdtodec(Second & 0x7F);
1250:Core/Src/main.c **** 
1251:Core/Src/main.c ****     return get_unix_timestamp(2000 + Year, Month, Day, Hour, Minute, Second);
1252:Core/Src/main.c **** }
