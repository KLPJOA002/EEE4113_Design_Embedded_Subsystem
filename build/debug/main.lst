1254:Core/Src/main.c **** static void RTC_Set_Time(I2C_HandleTypeDef *hi2c,char *Time)
1255:Core/Src/main.c **** {
1256:Core/Src/main.c ****     // __DATE__ is "YYYY:MM:DD:HH:MM:SS"
1257:Core/Src/main.c **** 
1258:Core/Src/main.c ****     uint16_t year = (Time[0]-'0')*1000 + (Time[1]-'0')*100 + (Time[2]-'0')*10 + (Time[3]-'0');
1259:Core/Src/main.c ****     uint8_t month = (Time[5]-'0')*10 + (Time[6]-'0');
1260:Core/Src/main.c ****     uint8_t day = (Time[8]-'0')*10 + (Time[9]-'0');
1261:Core/Src/main.c ****     uint8_t hour = (Time[11]-'0')*10 + (Time[12]-'0');
1262:Core/Src/main.c ****     uint8_t minute = (Time[14]-'0')*10 + (Time[15]-'0');
1263:Core/Src/main.c ****     uint8_t second = (Time[17]-'0')*10 + (Time[18]-'0');
1264:Core/Src/main.c **** 
1265:Core/Src/main.c ****     // Write to DS3231 registers in BCD
1266:Core/Src/main.c ****     uint8_t reg_val;
1267:Core/Src/main.c **** 
1268:Core/Src/main.c ****     reg_val = decimalbcd(second);
1269:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Second, 1, &reg_val, 1, HAL_MAX_DELAY);
1270:Core/Src/main.c **** 
1271:Core/Src/main.c ****     reg_val = decimalbcd(minute);
1272:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Minute, 1, &reg_val, 1, HAL_MAX_DELAY);
1273:Core/Src/main.c **** 
1274:Core/Src/main.c ****     reg_val = decimalbcd(hour);
1275:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Hour, 1, &reg_val, 1, HAL_MAX_DELAY);
1276:Core/Src/main.c **** 
1277:Core/Src/main.c ****     reg_val = decimalbcd(day);
1278:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Day, 1, &reg_val, 1, HAL_MAX_DELAY);
1279:Core/Src/main.c **** 
1280:Core/Src/main.c ****     reg_val = decimalbcd(month);
1281:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Month, 1, &reg_val, 1, HAL_MAX_DELAY);
1282:Core/Src/main.c **** 
1283:Core/Src/main.c ****     reg_val = decimalbcd(year % 100); // DS3231 only stores last 2 digits
1284:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Year, 1, &reg_val, 1, HAL_MAX_DELAY);
1285:Core/Src/main.c **** 
1286:Core/Src/main.c ****     // Write magic flag so we never set time again
1287:Core/Src/main.c ****     reg_val = RTC_MAGIC_VAL;
1288:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_MAGIC_REG, 1, &reg_val, 1, HAL_MAX_DELAY);
1289:Core/Src/main.c **** }
