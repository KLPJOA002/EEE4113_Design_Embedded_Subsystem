 903:Core/Src/main.c **** 
 904:Core/Src/main.c **** static uint32_t RTC_Get_Time(I2C_HandleTypeDef *hi2c)
 905:Core/Src/main.c **** {
 906:Core/Src/main.c ****     uint8_t Year, Month, Day, Hour, Minute, Second;
 907:Core/Src/main.c **** 
 908:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Year,   1, &Year,   1, HAL_MAX_DELAY);
 909:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Month,  1, &Month,  1, HAL_MAX_DELAY);
 910:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Day,    1, &Day,    1, HAL_MAX_DELAY);
 911:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Hour,   1, &Hour,   1, HAL_MAX_DELAY);
 912:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Minute, 1, &Minute, 1, HAL_MAX_DELAY);
 913:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Second, 1, &Second, 1, HAL_MAX_DELAY);
 914:Core/Src/main.c **** 
 915:Core/Src/main.c ****     // Mask status bits BEFORE BCD conversion
 916:Core/Src/main.c ****     Year   = bcdtodec(Year);
 917:Core/Src/main.c ****     Month  = bcdtodec(Month  & 0x1F); // mask century bit
 918:Core/Src/main.c ****     Day    = bcdtodec(Day    & 0x3F);
 919:Core/Src/main.c ****     Hour   = bcdtodec(Hour   & 0x3F); // mask 12/24hr bit
 920:Core/Src/main.c ****     Minute = bcdtodec(Minute & 0x7F);
 921:Core/Src/main.c ****     Second = bcdtodec(Second & 0x7F);
 922:Core/Src/main.c **** 
 923:Core/Src/main.c ****     return get_unix_timestamp(2000 + Year, Month, Day, Hour, Minute, Second);
 924:Core/Src/main.c **** }
