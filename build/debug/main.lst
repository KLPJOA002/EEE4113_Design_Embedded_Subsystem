1440:Core/Src/main.c **** static uint8_t SD_DataDump(void)
1441:Core/Src/main.c **** {
1442:Core/Src/main.c ****     if (!SD_Connected) return 0;
1443:Core/Src/main.c **** 
1444:Core/Src/main.c ****     FATFS   FatFs;
1445:Core/Src/main.c ****     DIR     dir;
1446:Core/Src/main.c ****     FILINFO fno;
1447:Core/Src/main.c ****     FIL     fil;
1448:Core/Src/main.c ****     FRESULT fres;
1449:Core/Src/main.c **** 
1450:Core/Src/main.c ****     fres = f_mount(&FatFs, "", 1);
1451:Core/Src/main.c ****     if (fres != FR_OK) return 0;
1452:Core/Src/main.c **** 
1453:Core/Src/main.c ****     fres = f_opendir(&dir, "/");
1454:Core/Src/main.c ****     if (fres != FR_OK) { f_mount(NULL, "", 0); return 0; }
1455:Core/Src/main.c **** 
ARM GAS  C:\Users\joabk\AppData\Local\Temp\cc3EDvy1.s 			page 27


1456:Core/Src/main.c ****     uint16_t count = 0;
1457:Core/Src/main.c ****     char tx_buf[100];
1458:Core/Src/main.c **** 
1459:Core/Src/main.c ****     while (1)
1460:Core/Src/main.c ****     {
1461:Core/Src/main.c ****         fres = f_readdir(&dir, &fno);
1462:Core/Src/main.c ****         // End of directory or error
1463:Core/Src/main.c ****         if (fres != FR_OK || fno.fname[0] == '\0') break;
1464:Core/Src/main.c ****         // Skip directories and non-CSV files
1465:Core/Src/main.c ****         if (fno.fattrib & AM_DIR) continue;
1466:Core/Src/main.c ****         if (strstr(fno.fname, "READING.CSV") == NULL) continue;
1467:Core/Src/main.c **** 
1468:Core/Src/main.c ****         // Open the file
1469:Core/Src/main.c ****         fres = f_open(&fil, fno.fname, FA_READ);
1470:Core/Src/main.c ****         if (fres != FR_OK) continue;
1471:Core/Src/main.c **** 
1472:Core/Src/main.c ****         // --- Parse the CSV ---
1473:Core/Src/main.c ****         // File format (after header):
1474:Core/Src/main.c ****         //   2025-05-10 12:30:00,DO_1,8.45
1475:Core/Src/main.c ****         //   2025-05-10 12:30:00,RTD_1,22.1
1476:Core/Src/main.c ****         //   2025-05-10 12:30:00,DO_2,7.90
1477:Core/Src/main.c ****         //   2025-05-10 12:30:00,RTD_2,21.5
1478:Core/Src/main.c **** 
1479:Core/Src/main.c ****         char line[60];
1480:Core/Src/main.c ****         char ts[20]   = "";
1481:Core/Src/main.c ****         char do1[16]  = "";
1482:Core/Src/main.c ****         char rtd1[16] = "";
1483:Core/Src/main.c ****         char do2[16]  = "";
1484:Core/Src/main.c ****         char rtd2[16] = "";
1485:Core/Src/main.c **** 
1486:Core/Src/main.c ****         // Skip header line
1487:Core/Src/main.c ****         f_gets(line, sizeof(line), &fil);
1488:Core/Src/main.c **** 
1489:Core/Src/main.c ****         // Read the 4 data lines
1490:Core/Src/main.c ****         while (f_gets(line, sizeof(line), &fil))
1491:Core/Src/main.c ****         {
1492:Core/Src/main.c ****             // Remove trailing newline
1493:Core/Src/main.c ****             line[strcspn(line, "\r\n")] = '\0';
1494:Core/Src/main.c **** 
1495:Core/Src/main.c ****             // Split: "YYYY-MM-DD HH:MM:SS,SENSOR,VALUE"
1496:Core/Src/main.c ****             char *col1 = strtok(line, ",");   // timestamp
1497:Core/Src/main.c ****             char *col2 = strtok(NULL, ",");   // sensor name
1498:Core/Src/main.c ****             char *col3 = strtok(NULL, ",");   // value
1499:Core/Src/main.c **** 
1500:Core/Src/main.c ****             if (!col1 || !col2 || !col3) continue;
1501:Core/Src/main.c **** 
1502:Core/Src/main.c ****             // Capture timestamp from first row (all rows share same timestamp)
1503:Core/Src/main.c ****             if (ts[0] == '\0') strncpy(ts, col1, sizeof(ts)-1);
1504:Core/Src/main.c **** 
1505:Core/Src/main.c ****             if      (strcmp(col2, "DO_1")  == 0) strncpy(do1,  col3, sizeof(do1)-1);
1506:Core/Src/main.c ****             else if (strcmp(col2, "RTD_1") == 0) strncpy(rtd1, col3, sizeof(rtd1)-1);
1507:Core/Src/main.c ****             else if (strcmp(col2, "DO_2")  == 0) strncpy(do2,  col3, sizeof(do2)-1);
1508:Core/Src/main.c ****             else if (strcmp(col2, "RTD_2") == 0) strncpy(rtd2, col3, sizeof(rtd2)-1);
1509:Core/Src/main.c ****         }
1510:Core/Src/main.c **** 
1511:Core/Src/main.c ****         f_close(&fil);
1512:Core/Src/main.c **** 
ARM GAS  C:\Users\joabk\AppData\Local\Temp\cc3EDvy1.s 			page 28


1513:Core/Src/main.c ****         // Convert timestamp "YYYY-MM-DD HH:MM:SS" → "YYYY_MM_DD_HH_MM_SS"
1514:Core/Src/main.c ****         // Replace spaces, dashes, colons with underscores
1515:Core/Src/main.c ****         char ts_fmt[20] = "";
1516:Core/Src/main.c ****         strncpy(ts_fmt, ts, sizeof(ts_fmt)-1);
1517:Core/Src/main.c ****         for (int i = 0; ts_fmt[i]; i++) {
1518:Core/Src/main.c ****             if (ts_fmt[i] == ' ' || ts_fmt[i] == '-' || ts_fmt[i] == ':')
1519:Core/Src/main.c ****                 ts_fmt[i] = '_';
1520:Core/Src/main.c ****         }
1521:Core/Src/main.c **** 
1522:Core/Src/main.c ****         // Transmit Chamber 0 (DO_1 / RTD_1)
1523:Core/Src/main.c ****         snprintf(tx_buf, sizeof(tx_buf),
1524:Core/Src/main.c ****                  "TYPE:2,BUOY:0,CHAMBER:0,DO:%s,RTD:%s,TS:%s",
1525:Core/Src/main.c ****                  do1, rtd1, ts_fmt);
1526:Core/Src/main.c ****         LoRa_TX_Continuous(tx_buf);
1527:Core/Src/main.c **** 
1528:Core/Src/main.c ****         // Transmit Chamber 1 (DO_2 / RTD_2)
1529:Core/Src/main.c ****         snprintf(tx_buf, sizeof(tx_buf),
1530:Core/Src/main.c ****                  "TYPE:2,BUOY:0,CHAMBER:1,DO:%s,RTD:%s,TS:%s",
1531:Core/Src/main.c ****                  do2, rtd2, ts_fmt);
1532:Core/Src/main.c ****         LoRa_TX_Continuous(tx_buf);
1533:Core/Src/main.c **** 
1534:Core/Src/main.c ****         count++;
1535:Core/Src/main.c ****     }
1536:Core/Src/main.c **** 
1537:Core/Src/main.c ****     f_closedir(&dir);
1538:Core/Src/main.c ****     f_mount(NULL, "", 0);
1539:Core/Src/main.c **** 
1540:Core/Src/main.c ****     // Send the end-of-dump summary (count = number of readings, not packets)
1541:Core/Src/main.c ****     snprintf(tx_buf, sizeof(tx_buf), "TYPE:4,BUOY:0,COUNT:%u", count);
1542:Core/Src/main.c ****     LoRa_TX(tx_buf);
1543:Core/Src/main.c **** 
1544:Core/Src/main.c ****     return count;
1545:Core/Src/main.c **** }
