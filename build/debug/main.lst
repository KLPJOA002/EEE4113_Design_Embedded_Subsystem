1650:Core/Src/main.c ****         // --- Parse the CSV ---
1651:Core/Src/main.c ****         // File format (after header):
1652:Core/Src/main.c ****         //   2025-05-10 12:30:00,DO_1,8.45
1653:Core/Src/main.c ****         //   2025-05-10 12:30:00,RTD_1,22.1
1654:Core/Src/main.c ****         //   2025-05-10 12:30:00,DO_2,7.90
1655:Core/Src/main.c ****         //   2025-05-10 12:30:00,RTD_2,21.5
1656:Core/Src/main.c **** 
1657:Core/Src/main.c ****         char line[60];
1658:Core/Src/main.c ****         char ts[20]   = "";
1659:Core/Src/main.c ****         char do1[16]  = "";
1660:Core/Src/main.c ****         char rtd1[16] = "";
1661:Core/Src/main.c ****         char do2[16]  = "";
1662:Core/Src/main.c ****         char rtd2[16] = "";
1663:Core/Src/main.c **** 
1664:Core/Src/main.c ****         // Skip header line
1665:Core/Src/main.c ****         f_gets(line, sizeof(line), &fil);
1666:Core/Src/main.c **** 
1667:Core/Src/main.c ****         // Read the 4 data lines
1668:Core/Src/main.c ****         while (f_gets(line, sizeof(line), &fil))
1669:Core/Src/main.c ****         {
1670:Core/Src/main.c ****             // Remove trailing newline
1671:Core/Src/main.c ****             line[strcspn(line, "\r\n")] = '\0';
1672:Core/Src/main.c **** 
1673:Core/Src/main.c ****             // Split: "YYYY-MM-DD HH:MM:SS,SENSOR,VALUE"
1674:Core/Src/main.c ****             char *col1 = strtok(line, ",");   // timestamp
1675:Core/Src/main.c ****             char *col2 = strtok(NULL, ",");   // sensor name
1676:Core/Src/main.c ****             char *col3 = strtok(NULL, ",");   // value
