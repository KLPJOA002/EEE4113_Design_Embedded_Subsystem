1409:Core/Src/main.c **** 
1410:Core/Src/main.c ****     uint8_t addr = SX1278_SPIRead(&SX1278, LR_RegFifoTxBaseAddr);
1411:Core/Src/main.c ****     SX1278_SPIWrite(&SX1278, LR_RegFifoAddrPtr, addr);
1412:Core/Src/main.c **** 
1413:Core/Src/main.c ****     SX1278.status = TX;  // set before firing so EXTI handler ignores DIO0
1414:Core/Src/main.c **** 
1415:Core/Src/main.c ****     // Write payload and fire
1416:Core/Src/main.c ****     SX1278_SPIBurstWrite(&SX1278, 0x00, (uint8_t*)message, msg_len);
1417:Core/Src/main.c ****     SX1278_SPIWrite(&SX1278, LR_RegOpMode, 0x8B);  // TX mode
1418:Core/Src/main.c **** 
1419:Core/Src/main.c ****     // Poll for TxDone
1420:Core/Src/main.c ****     uint32_t deadline = HAL_GetTick() + 3000;
1421:Core/Src/main.c ****     while (!SX1278_hw_GetDIO0(SX1278.hw))
1422:Core/Src/main.c ****     {
1423:Core/Src/main.c ****         if (HAL_GetTick() > deadline) return 0;
1424:Core/Src/main.c ****     }
