1373:Core/Src/main.c **** static uint32_t RTC_Get_Time(I2C_HandleTypeDef *hi2c)
1374:Core/Src/main.c **** {
1375:Core/Src/main.c ****     uint8_t Year, Month, Day, Hour, Minute, Second;
1376:Core/Src/main.c **** 
1377:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Year,   1, &Year,   1, HAL_MAX_DELAY);
1378:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Month,  1, &Month,  1, HAL_MAX_DELAY);
1379:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Day,    1, &Day,    1, HAL_MAX_DELAY);
1380:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Hour,   1, &Hour,   1, HAL_MAX_DELAY);
1381:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Minute, 1, &Minute, 1, HAL_MAX_DELAY);
1382:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Second, 1, &Second, 1, HAL_MAX_DELAY);
1383:Core/Src/main.c **** 
1384:Core/Src/main.c ****     // Mask status bits BEFORE BCD conversion
1385:Core/Src/main.c ****     Year   = bcdtodec(Year);
1386:Core/Src/main.c ****     Month  = bcdtodec(Month  & 0x1F); // mask century bit
1387:Core/Src/main.c ****     Day    = bcdtodec(Day    & 0x3F);
1388:Core/Src/main.c ****     Hour   = bcdtodec(Hour   & 0x3F); // mask 12/24hr bit
1389:Core/Src/main.c ****     Minute = bcdtodec(Minute & 0x7F);
1390:Core/Src/main.c ****     Second = bcdtodec(Second & 0x7F);
1391:Core/Src/main.c **** 
1392:Core/Src/main.c ****     return get_unix_timestamp(2000 + Year, Month, Day, Hour, Minute, Second);
1393:Core/Src/main.c **** }
