 632:Core/Src/main.c **** static uint32_t get_unix_timestamp(uint16_t year, uint8_t month, uint8_t day, 
 633:Core/Src/main.c ****                            uint8_t hour, uint8_t min, uint8_t sec) 
 634:Core/Src/main.c **** {
 635:Core/Src/main.c ****     struct tm t;
 636:Core/Src/main.c ****     time_t t_of_day;
 637:Core/Src/main.c **** 
 638:Core/Src/main.c ****     // Standard C struct tm requirements:
 639:Core/Src/main.c ****     t.tm_year = year - 1900;  // Year since 1900
 640:Core/Src/main.c ****     t.tm_mon = month - 1;     // Month, 0 - 11
 641:Core/Src/main.c ****     t.tm_mday = day;          // Day of the month
 642:Core/Src/main.c ****     t.tm_hour = hour;
