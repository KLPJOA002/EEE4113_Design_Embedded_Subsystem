 621:Core/Src/main.c **** static uint32_t RTC_Get_Time(I2C_HandleTypeDef *hi2c)
 622:Core/Src/main.c **** {
 623:Core/Src/main.c ****     uint8_t Year, Month, Day, Hour, Minute, Second;
 624:Core/Src/main.c **** 
 625:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Year,   1, &Year,   1, HAL_MAX_DELAY);
 626:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Month,  1, &Month,  1, HAL_MAX_DELAY);
 627:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Day,    1, &Day,    1, HAL_MAX_DELAY);
 628:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Hour,   1, &Hour,   1, HAL_MAX_DELAY);
 629:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Minute, 1, &Minute, 1, HAL_MAX_DELAY);
 630:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Second, 1, &Second, 1, HAL_MAX_DELAY);
 631:Core/Src/main.c **** 
 632:Core/Src/main.c ****     // Mask status bits BEFORE BCD conversion
 633:Core/Src/main.c ****     Year   = bcdtodec(Year);
 634:Core/Src/main.c ****     Month  = bcdtodec(Month  & 0x1F); // mask century bit
 635:Core/Src/main.c ****     Day    = bcdtodec(Day    & 0x3F);
 636:Core/Src/main.c ****     Hour   = bcdtodec(Hour   & 0x3F); // mask 12/24hr bit
 637:Core/Src/main.c ****     Minute = bcdtodec(Minute & 0x7F);
 638:Core/Src/main.c ****     Second = bcdtodec(Second & 0x7F);
 639:Core/Src/main.c **** 
 640:Core/Src/main.c ****     return get_unix_timestamp(2000 + Year, Month, Day, Hour, Minute, Second);
 641:Core/Src/main.c **** }
