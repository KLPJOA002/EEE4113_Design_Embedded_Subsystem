1291:Core/Src/main.c **** static uint32_t get_unix_timestamp(uint16_t year, uint8_t month, uint8_t day, 
ARM GAS  C:\Users\joabk\AppData\Local\Temp\ccpTartM.s 			page 33


1292:Core/Src/main.c ****                            uint8_t hour, uint8_t min, uint8_t sec) 
1293:Core/Src/main.c **** {
1294:Core/Src/main.c ****     struct tm t;
1295:Core/Src/main.c ****     time_t t_of_day;
1296:Core/Src/main.c **** 
1297:Core/Src/main.c ****     // Standard C struct tm requirements:
1298:Core/Src/main.c ****     t.tm_year = year - 1900;  // Year since 1900
1299:Core/Src/main.c ****     t.tm_mon = month - 1;     // Month, 0 - 11
1300:Core/Src/main.c ****     t.tm_mday = day;          // Day of the month
1301:Core/Src/main.c ****     t.tm_hour = hour;
1302:Core/Src/main.c ****     t.tm_min = min;
1303:Core/Src/main.c ****     t.tm_sec = sec;
1304:Core/Src/main.c ****     t.tm_isdst = -1;          // Is Daylight Savings Time on? -1 = let the library decide
1305:Core/Src/main.c **** 
1306:Core/Src/main.c ****     t_of_day = mktime(&t);
1307:Core/Src/main.c **** 
1308:Core/Src/main.c ****     return (uint32_t)t_of_day;
1309:Core/Src/main.c **** }
