1359:Core/Src/main.c **** static uint32_t get_unix_timestamp(uint16_t year, uint8_t month, uint8_t day, 
1360:Core/Src/main.c ****                            uint8_t hour, uint8_t min, uint8_t sec) 
1361:Core/Src/main.c **** {
1362:Core/Src/main.c ****     struct tm t;
1363:Core/Src/main.c ****     time_t t_of_day;
1364:Core/Src/main.c **** 
1365:Core/Src/main.c ****     // Standard C struct tm requirements:
1366:Core/Src/main.c ****     t.tm_year = year - 1900;  // Year since 1900
1367:Core/Src/main.c ****     t.tm_mon = month - 1;     // Month, 0 - 11
1368:Core/Src/main.c ****     t.tm_mday = day;          // Day of the month
1369:Core/Src/main.c ****     t.tm_hour = hour;
1370:Core/Src/main.c ****     t.tm_min = min;
1371:Core/Src/main.c ****     t.tm_sec = sec;
1372:Core/Src/main.c ****     t.tm_isdst = -1;          // Is Daylight Savings Time on? -1 = let the library decide
1373:Core/Src/main.c **** 
1374:Core/Src/main.c ****     t_of_day = mktime(&t);
1375:Core/Src/main.c **** 
1376:Core/Src/main.c ****     return (uint32_t)t_of_day;
1377:Core/Src/main.c **** }
