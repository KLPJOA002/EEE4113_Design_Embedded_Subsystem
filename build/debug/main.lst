1402:Core/Src/main.c ****     // Lightweight TX setup — no SX1278_config, no 15ms delay
1403:Core/Src/main.c ****     SX1278_SPIWrite(&SX1278, REG_LR_PADAC,        0x87);  // PA boost
1404:Core/Src/main.c ****     SX1278_SPIWrite(&SX1278, LR_RegHopPeriod,     0x00);
