1266:Core/Src/main.c ****     if (msg_len == 0 || msg_len > 100) return 0;
1267:Core/Src/main.c **** 
1268:Core/Src/main.c ****     // Lightweight TX setup — no SX1278_config, no 15ms delay
1269:Core/Src/main.c ****     SX1278_SPIWrite(&SX1278, REG_LR_PADAC,        0x87);  // PA boost
1270:Core/Src/main.c ****     SX1278_SPIWrite(&SX1278, LR_RegHopPeriod,     0x00);
