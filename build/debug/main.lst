1197:Core/Src/main.c **** static void RTC_Set_Time_Once(I2C_HandleTypeDef *hi2c)
1198:Core/Src/main.c **** {
1199:Core/Src/main.c ****     // Check if time has already been set
1200:Core/Src/main.c ****     uint8_t magic = 0;
1201:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_MAGIC_REG, 1, &magic, 1, HAL_MAX_DELAY);
1202:Core/Src/main.c ****     
1203:Core/Src/main.c ****     if (magic == RTC_MAGIC_VAL)
1204:Core/Src/main.c ****         return; // Already set, skip
1205:Core/Src/main.c **** 
1206:Core/Src/main.c ****     // Parse compile-time strings into numbers
1207:Core/Src/main.c ****     // __DATE__ is "Mon DD YYYY" e.g. "Apr 22 2026"
1208:Core/Src/main.c ****     // __TIME__ is "HH:MM:SS"   e.g. "14:30:00"
1209:Core/Src/main.c ****     char date[] = __DATE__;
1210:Core/Src/main.c ****     char time[] = __TIME__;
1211:Core/Src/main.c **** 
1212:Core/Src/main.c ****     uint8_t day    = ((date[4] == ' ') ? 0 : (date[4] - '0')) * 10 + (date[5] - '0');
1213:Core/Src/main.c ****     uint16_t year  = (date[7]-'0')*1000 + (date[8]-'0')*100 + (date[9]-'0')*10 + (date[10]-'0');
1214:Core/Src/main.c ****     uint8_t hour   = (time[0]-'0')*10 + (time[1]-'0');
1215:Core/Src/main.c ****     uint8_t minute = (time[3]-'0')*10 + (time[4]-'0');
1216:Core/Src/main.c ****     uint8_t second = (time[6]-'0')*10 + (time[7]-'0');
1217:Core/Src/main.c **** 
1218:Core/Src/main.c ****     // Parse month string
1219:Core/Src/main.c ****     const char *months = "JanFebMarAprMayJunJulAugSepOctNovDec";
1220:Core/Src/main.c ****     uint8_t month = 1;
1221:Core/Src/main.c ****     for (int i = 0; i < 12; i++) {
1222:Core/Src/main.c ****         if (strncmp(&months[i*3], date, 3) == 0) {
1223:Core/Src/main.c ****             month = i + 1;
1224:Core/Src/main.c ****             break;
1225:Core/Src/main.c ****         }
1226:Core/Src/main.c ****     }
1227:Core/Src/main.c **** 
1228:Core/Src/main.c ****     // Write to DS3231 registers in BCD
1229:Core/Src/main.c ****     uint8_t reg_val;
1230:Core/Src/main.c **** 
1231:Core/Src/main.c ****     reg_val = decimalbcd(second);
1232:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Second, 1, &reg_val, 1, HAL_MAX_DELAY);
1233:Core/Src/main.c **** 
1234:Core/Src/main.c ****     reg_val = decimalbcd(minute);
ARM GAS  C:\Users\joabk\AppData\Local\Temp\ccpTartM.s 			page 32


1235:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Minute, 1, &reg_val, 1, HAL_MAX_DELAY);
1236:Core/Src/main.c **** 
1237:Core/Src/main.c ****     reg_val = decimalbcd(hour);
1238:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Hour, 1, &reg_val, 1, HAL_MAX_DELAY);
1239:Core/Src/main.c **** 
1240:Core/Src/main.c ****     reg_val = decimalbcd(day);
1241:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Day, 1, &reg_val, 1, HAL_MAX_DELAY);
1242:Core/Src/main.c **** 
1243:Core/Src/main.c ****     reg_val = decimalbcd(month);
1244:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Month, 1, &reg_val, 1, HAL_MAX_DELAY);
1245:Core/Src/main.c **** 
1246:Core/Src/main.c ****     reg_val = decimalbcd(year % 100); // DS3231 only stores last 2 digits
1247:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Year, 1, &reg_val, 1, HAL_MAX_DELAY);
1248:Core/Src/main.c **** 
1249:Core/Src/main.c ****     // Write magic flag so we never set time again
1250:Core/Src/main.c ****     reg_val = RTC_MAGIC_VAL;
1251:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_MAGIC_REG, 1, &reg_val, 1, HAL_MAX_DELAY);
1252:Core/Src/main.c **** }
