1679:Core/Src/main.c **** static uint32_t get_unix_timestamp(uint16_t year, uint8_t month, uint8_t day, 
1680:Core/Src/main.c ****                            uint8_t hour, uint8_t min, uint8_t sec) 
1681:Core/Src/main.c **** {
1682:Core/Src/main.c ****     struct tm t;
