1243:Core/Src/main.c **** static uint32_t RTC_Get_Time(I2C_HandleTypeDef *hi2c)
1244:Core/Src/main.c **** {
1245:Core/Src/main.c ****     uint8_t Year, Month, Day, Hour, Minute, Second;
1246:Core/Src/main.c **** 
1247:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Year,   1, &Year,   1, HAL_MAX_DELAY);
1248:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Month,  1, &Month,  1, HAL_MAX_DELAY);
1249:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Day,    1, &Day,    1, HAL_MAX_DELAY);
1250:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Hour,   1, &Hour,   1, HAL_MAX_DELAY);
1251:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Minute, 1, &Minute, 1, HAL_MAX_DELAY);
1252:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Second, 1, &Second, 1, HAL_MAX_DELAY);
1253:Core/Src/main.c **** 
1254:Core/Src/main.c ****     // Mask status bits BEFORE BCD conversion
1255:Core/Src/main.c ****     Year   = bcdtodec(Year);
1256:Core/Src/main.c ****     Month  = bcdtodec(Month  & 0x1F); // mask century bit
1257:Core/Src/main.c ****     Day    = bcdtodec(Day    & 0x3F);
1258:Core/Src/main.c ****     Hour   = bcdtodec(Hour   & 0x3F); // mask 12/24hr bit
1259:Core/Src/main.c ****     Minute = bcdtodec(Minute & 0x7F);
1260:Core/Src/main.c ****     Second = bcdtodec(Second & 0x7F);
1261:Core/Src/main.c **** 
1262:Core/Src/main.c ****     return get_unix_timestamp(2000 + Year, Month, Day, Hour, Minute, Second);
1263:Core/Src/main.c **** }
1264:Core/Src/main.c **** 
1265:Core/Src/main.c **** static void RTC_Set_Time_Once(I2C_HandleTypeDef *hi2c)
1266:Core/Src/main.c **** {
1267:Core/Src/main.c ****     // Check if time has already been set
1268:Core/Src/main.c ****     uint8_t magic = 0;
1269:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_MAGIC_REG, 1, &magic, 1, HAL_MAX_DELAY);
1270:Core/Src/main.c ****     
1271:Core/Src/main.c ****     if (magic == RTC_MAGIC_VAL)
1272:Core/Src/main.c ****         return; // Already set, skip
1273:Core/Src/main.c **** 
1274:Core/Src/main.c ****     // Parse compile-time strings into numbers
1275:Core/Src/main.c ****     // __DATE__ is "Mon DD YYYY" e.g. "Apr 22 2026"
1276:Core/Src/main.c ****     // __TIME__ is "HH:MM:SS"   e.g. "14:30:00"
1277:Core/Src/main.c ****     char date[] = __DATE__;
1278:Core/Src/main.c ****     char time[] = __TIME__;
1279:Core/Src/main.c **** 
1280:Core/Src/main.c ****     uint8_t day    = ((date[4] == ' ') ? 0 : (date[4] - '0')) * 10 + (date[5] - '0');
1281:Core/Src/main.c ****     uint16_t year  = (date[7]-'0')*1000 + (date[8]-'0')*100 + (date[9]-'0')*10 + (date[10]-'0');
1282:Core/Src/main.c ****     uint8_t hour   = (time[0]-'0')*10 + (time[1]-'0');
1283:Core/Src/main.c ****     uint8_t minute = (time[3]-'0')*10 + (time[4]-'0');
1284:Core/Src/main.c ****     uint8_t second = (time[6]-'0')*10 + (time[7]-'0');
1285:Core/Src/main.c **** 
1286:Core/Src/main.c ****     // Parse month string
1287:Core/Src/main.c ****     const char *months = "JanFebMarAprMayJunJulAugSepOctNovDec";
1288:Core/Src/main.c ****     uint8_t month = 1;
1289:Core/Src/main.c ****     for (int i = 0; i < 12; i++) {
1290:Core/Src/main.c ****         if (strncmp(&months[i*3], date, 3) == 0) {
1291:Core/Src/main.c ****             month = i + 1;
ARM GAS  C:\Users\joabk\AppData\Local\Temp\ccQqFiQ2.s 			page 33


1292:Core/Src/main.c ****             break;
1293:Core/Src/main.c ****         }
1294:Core/Src/main.c ****     }
1295:Core/Src/main.c **** 
1296:Core/Src/main.c ****     // Write to DS3231 registers in BCD
1297:Core/Src/main.c ****     uint8_t reg_val;
1298:Core/Src/main.c **** 
1299:Core/Src/main.c ****     reg_val = decimalbcd(second);
1300:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Second, 1, &reg_val, 1, HAL_MAX_DELAY);
1301:Core/Src/main.c **** 
1302:Core/Src/main.c ****     reg_val = decimalbcd(minute);
1303:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Minute, 1, &reg_val, 1, HAL_MAX_DELAY);
1304:Core/Src/main.c **** 
1305:Core/Src/main.c ****     reg_val = decimalbcd(hour);
1306:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Hour, 1, &reg_val, 1, HAL_MAX_DELAY);
1307:Core/Src/main.c **** 
1308:Core/Src/main.c ****     reg_val = decimalbcd(day);
1309:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Day, 1, &reg_val, 1, HAL_MAX_DELAY);
1310:Core/Src/main.c **** 
1311:Core/Src/main.c ****     reg_val = decimalbcd(month);
1312:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Month, 1, &reg_val, 1, HAL_MAX_DELAY);
1313:Core/Src/main.c **** 
1314:Core/Src/main.c ****     reg_val = decimalbcd(year % 100); // DS3231 only stores last 2 digits
1315:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Year, 1, &reg_val, 1, HAL_MAX_DELAY);
1316:Core/Src/main.c **** 
1317:Core/Src/main.c ****     // Write magic flag so we never set time again
1318:Core/Src/main.c ****     reg_val = RTC_MAGIC_VAL;
1319:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_MAGIC_REG, 1, &reg_val, 1, HAL_MAX_DELAY);
1320:Core/Src/main.c **** }
1321:Core/Src/main.c **** 
1322:Core/Src/main.c **** static void RTC_Set_Time(I2C_HandleTypeDef *hi2c,char *Time)
1323:Core/Src/main.c **** {
1324:Core/Src/main.c ****     // __DATE__ is "YYYY:MM:DD:HH:MM:SS"
1325:Core/Src/main.c **** 
1326:Core/Src/main.c ****     uint16_t year = (Time[0]-'0')*1000 + (Time[1]-'0')*100 + (Time[2]-'0')*10 + (Time[3]-'0');
1327:Core/Src/main.c ****     uint8_t month = (Time[5]-'0')*10 + (Time[6]-'0');
1328:Core/Src/main.c ****     uint8_t day = (Time[8]-'0')*10 + (Time[9]-'0');
1329:Core/Src/main.c ****     uint8_t hour = (Time[11]-'0')*10 + (Time[12]-'0');
1330:Core/Src/main.c ****     uint8_t minute = (Time[14]-'0')*10 + (Time[15]-'0');
1331:Core/Src/main.c ****     uint8_t second = (Time[17]-'0')*10 + (Time[18]-'0');
1332:Core/Src/main.c **** 
1333:Core/Src/main.c ****     // Write to DS3231 registers in BCD
1334:Core/Src/main.c ****     uint8_t reg_val;
