1642:Core/Src/main.c **** static void RTC_Set_Time(I2C_HandleTypeDef *hi2c,char *Time)
1643:Core/Src/main.c **** {
1644:Core/Src/main.c ****     // __DATE__ is "YYYY:MM:DD:HH:MM:SS"
1645:Core/Src/main.c **** 
1646:Core/Src/main.c ****     uint16_t year = (Time[0]-'0')*1000 + (Time[1]-'0')*100 + (Time[2]-'0')*10 + (Time[3]-'0');
1647:Core/Src/main.c ****     uint8_t month = (Time[5]-'0')*10 + (Time[6]-'0');
1648:Core/Src/main.c ****     uint8_t day = (Time[8]-'0')*10 + (Time[9]-'0');
1649:Core/Src/main.c ****     uint8_t hour = (Time[11]-'0')*10 + (Time[12]-'0');
1650:Core/Src/main.c ****     uint8_t minute = (Time[14]-'0')*10 + (Time[15]-'0');
1651:Core/Src/main.c ****     uint8_t second = (Time[17]-'0')*10 + (Time[18]-'0');
1652:Core/Src/main.c **** 
1653:Core/Src/main.c ****     // Write to DS3231 registers in BCD
1654:Core/Src/main.c ****     uint8_t reg_val;
1655:Core/Src/main.c **** 
1656:Core/Src/main.c ****     reg_val = decimalbcd(second);
1657:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Second, 1, &reg_val, 1, HAL_MAX_DELAY);
1658:Core/Src/main.c **** 
1659:Core/Src/main.c ****     reg_val = decimalbcd(minute);
1660:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Minute, 1, &reg_val, 1, HAL_MAX_DELAY);
1661:Core/Src/main.c **** 
1662:Core/Src/main.c ****     reg_val = decimalbcd(hour);
1663:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Hour, 1, &reg_val, 1, HAL_MAX_DELAY);
1664:Core/Src/main.c **** 
1665:Core/Src/main.c ****     reg_val = decimalbcd(day);
1666:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Day, 1, &reg_val, 1, HAL_MAX_DELAY);
1667:Core/Src/main.c **** 
1668:Core/Src/main.c ****     reg_val = decimalbcd(month);
1669:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Month, 1, &reg_val, 1, HAL_MAX_DELAY);
1670:Core/Src/main.c **** 
1671:Core/Src/main.c ****     reg_val = decimalbcd(year % 100); // DS3231 only stores last 2 digits
1672:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Year, 1, &reg_val, 1, HAL_MAX_DELAY);
1673:Core/Src/main.c **** 
1674:Core/Src/main.c ****     // Write magic flag so we never set time again
1675:Core/Src/main.c ****     reg_val = RTC_MAGIC_VAL;
1676:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_MAGIC_REG, 1, &reg_val, 1, HAL_MAX_DELAY);
1677:Core/Src/main.c **** }
