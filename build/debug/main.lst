1811:Core/Src/main.c ****     reg_val = decimalbcd(hour);
1812:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Hour, 1, &reg_val, 1, HAL_MAX_DELAY);
1813:Core/Src/main.c **** 
1814:Core/Src/main.c ****     reg_val = decimalbcd(day);
1815:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Day, 1, &reg_val, 1, HAL_MAX_DELAY);
1816:Core/Src/main.c **** 
