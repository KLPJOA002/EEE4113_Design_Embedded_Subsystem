1865:Core/Src/main.c **** static uint32_t get_unix_timestamp(uint16_t year, uint8_t month, uint8_t day, uint8_t hour, uint8_t
1866:Core/Src/main.c **** {
1867:Core/Src/main.c ****     struct tm t;
1868:Core/Src/main.c ****     time_t t_of_day;
1869:Core/Src/main.c **** 
1870:Core/Src/main.c ****     // Standard C struct tm requirements:
1871:Core/Src/main.c ****     t.tm_year = year - 1900;  // Year since 1900
1872:Core/Src/main.c ****     t.tm_mon = month - 1;     // Month, 0 - 11
1873:Core/Src/main.c ****     t.tm_mday = day;          // Day of the month
1874:Core/Src/main.c ****     t.tm_hour = hour;
1875:Core/Src/main.c ****     t.tm_min = min;
1876:Core/Src/main.c ****     t.tm_sec = sec;
1877:Core/Src/main.c ****     t.tm_isdst = -1;          // Is Daylight Savings Time on? -1 = let the library decide
1878:Core/Src/main.c **** 
1879:Core/Src/main.c ****     t_of_day = mktime(&t);
1880:Core/Src/main.c **** 
1881:Core/Src/main.c ****     return (uint32_t)t_of_day;
1882:Core/Src/main.c **** }
