1820:Core/Src/main.c **** static uint32_t get_unix_timestamp(uint16_t year, uint8_t month, uint8_t day, uint8_t hour, uint8_t
1821:Core/Src/main.c **** {
1822:Core/Src/main.c ****     struct tm t;
1823:Core/Src/main.c ****     time_t t_of_day;
1824:Core/Src/main.c **** 
1825:Core/Src/main.c ****     // Standard C struct tm requirements:
1826:Core/Src/main.c ****     t.tm_year = year - 1900;  // Year since 1900
1827:Core/Src/main.c ****     t.tm_mon = month - 1;     // Month, 0 - 11
1828:Core/Src/main.c ****     t.tm_mday = day;          // Day of the month
1829:Core/Src/main.c ****     t.tm_hour = hour;
1830:Core/Src/main.c ****     t.tm_min = min;
1831:Core/Src/main.c ****     t.tm_sec = sec;
1832:Core/Src/main.c ****     t.tm_isdst = -1;          // Is Daylight Savings Time on? -1 = let the library decide
1833:Core/Src/main.c **** 
1834:Core/Src/main.c ****     t_of_day = mktime(&t);
1835:Core/Src/main.c **** 
1836:Core/Src/main.c ****     return (uint32_t)t_of_day;
1837:Core/Src/main.c **** }
