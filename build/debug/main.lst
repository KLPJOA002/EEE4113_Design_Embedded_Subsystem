1706:Core/Src/main.c ****         }
1707:Core/Src/main.c **** 
1708:Core/Src/main.c ****         // Transmit Chamber 0 (DO_1 / RTD_1)
1709:Core/Src/main.c ****         snprintf(tx_buf, sizeof(tx_buf),
1710:Core/Src/main.c ****                  "TYPE:2,BUOY:%d,CHAMBER:0,DO:%s,RTD:%s,TS:%s", BUOY_ID,
1711:Core/Src/main.c ****                  do1, rtd1, ts_fmt);
1712:Core/Src/main.c ****         LoRa_TX_Continuous(tx_buf);
1713:Core/Src/main.c **** 
1714:Core/Src/main.c ****         // Transmit Chamber 1 (DO_2 / RTD_2)
1715:Core/Src/main.c ****         snprintf(tx_buf, sizeof(tx_buf),
1716:Core/Src/main.c ****                  "TYPE:2,BUOY:%d,CHAMBER:1,DO:%s,RTD:%s,TS:%s", BUOY_ID,
1717:Core/Src/main.c ****                  do2, rtd2, ts_fmt);
1718:Core/Src/main.c ****         LoRa_TX_Continuous(tx_buf);
1719:Core/Src/main.c **** 
1720:Core/Src/main.c ****         count+=2;
1721:Core/Src/main.c ****     }
1722:Core/Src/main.c **** 
1723:Core/Src/main.c ****     f_closedir(&dir);
1724:Core/Src/main.c ****     f_mount(NULL, "", 0);
1725:Core/Src/main.c **** 
1726:Core/Src/main.c ****     // Send the end-of-dump summary (count = number of readings, not packets)
1727:Core/Src/main.c ****     snprintf(tx_buf, sizeof(tx_buf), "TYPE:4,BUOY:%d,COUNT:%lu", BUOY_ID, count);
1728:Core/Src/main.c ****     LoRa_TX(tx_buf);
1729:Core/Src/main.c **** 
