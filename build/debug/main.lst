 778:Core/Src/main.c ****     // Mask status bits BEFORE BCD conversion
 779:Core/Src/main.c ****     Year   = bcdtodec(Year);
 780:Core/Src/main.c ****     Month  = bcdtodec(Month  & 0x1F); // mask century bit
 781:Core/Src/main.c ****     Day    = bcdtodec(Day    & 0x3F);
 782:Core/Src/main.c ****     Hour   = bcdtodec(Hour   & 0x3F); // mask 12/24hr bit
 783:Core/Src/main.c ****     Minute = bcdtodec(Minute & 0x7F);
 784:Core/Src/main.c ****     Second = bcdtodec(Second & 0x7F);
 785:Core/Src/main.c **** 
 786:Core/Src/main.c ****     return get_unix_timestamp(2000 + Year, Month, Day, Hour, Minute, Second);
 787:Core/Src/main.c **** }
