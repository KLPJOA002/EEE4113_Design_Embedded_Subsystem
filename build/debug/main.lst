1004:Core/Src/main.c **** 
1005:Core/Src/main.c ****     // Mask status bits BEFORE BCD conversion
1006:Core/Src/main.c ****     Year   = bcdtodec(Year);
1007:Core/Src/main.c ****     Month  = bcdtodec(Month  & 0x1F); // mask century bit
1008:Core/Src/main.c ****     Day    = bcdtodec(Day    & 0x3F);
1009:Core/Src/main.c ****     Hour   = bcdtodec(Hour   & 0x3F); // mask 12/24hr bit
1010:Core/Src/main.c ****     Minute = bcdtodec(Minute & 0x7F);
1011:Core/Src/main.c ****     Second = bcdtodec(Second & 0x7F);
1012:Core/Src/main.c **** 
1013:Core/Src/main.c ****     return get_unix_timestamp(2000 + Year, Month, Day, Hour, Minute, Second);
1014:Core/Src/main.c **** }
