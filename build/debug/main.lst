 729:Core/Src/main.c **** static uint32_t RTC_Get_Time(I2C_HandleTypeDef *hi2c)
 730:Core/Src/main.c **** {
 731:Core/Src/main.c ****     uint8_t Year, Month, Day, Hour, Minute, Second;
 732:Core/Src/main.c **** 
 733:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Year,   1, &Year,   1, HAL_MAX_DELAY);
 734:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Month,  1, &Month,  1, HAL_MAX_DELAY);
 735:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Day,    1, &Day,    1, HAL_MAX_DELAY);
 736:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Hour,   1, &Hour,   1, HAL_MAX_DELAY);
 737:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Minute, 1, &Minute, 1, HAL_MAX_DELAY);
 738:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Second, 1, &Second, 1, HAL_MAX_DELAY);
 739:Core/Src/main.c **** 
 740:Core/Src/main.c ****     // Mask status bits BEFORE BCD conversion
 741:Core/Src/main.c ****     Year   = bcdtodec(Year);
 742:Core/Src/main.c ****     Month  = bcdtodec(Month  & 0x1F); // mask century bit
 743:Core/Src/main.c ****     Day    = bcdtodec(Day    & 0x3F);
 744:Core/Src/main.c ****     Hour   = bcdtodec(Hour   & 0x3F); // mask 12/24hr bit
 745:Core/Src/main.c ****     Minute = bcdtodec(Minute & 0x7F);
 746:Core/Src/main.c ****     Second = bcdtodec(Second & 0x7F);
 747:Core/Src/main.c **** 
 748:Core/Src/main.c ****     return get_unix_timestamp(2000 + Year, Month, Day, Hour, Minute, Second);
 749:Core/Src/main.c **** }
