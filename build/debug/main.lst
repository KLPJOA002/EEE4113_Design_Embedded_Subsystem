1292:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Minute, 1, &reg_val, 1, HAL_MAX_DELAY);
1293:Core/Src/main.c **** 
1294:Core/Src/main.c ****     reg_val = decimalbcd(hour);
1295:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Hour, 1, &reg_val, 1, HAL_MAX_DELAY);
1296:Core/Src/main.c **** 
1297:Core/Src/main.c ****     reg_val = decimalbcd(day);
1298:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Day, 1, &reg_val, 1, HAL_MAX_DELAY);
1299:Core/Src/main.c **** 
