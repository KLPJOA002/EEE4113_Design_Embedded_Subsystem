1146:Core/Src/main.c **** static uint32_t RTC_Get_Time(I2C_HandleTypeDef *hi2c)
1147:Core/Src/main.c **** {
1148:Core/Src/main.c ****     uint8_t Year, Month, Day, Hour, Minute, Second;
1149:Core/Src/main.c **** 
1150:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Year,   1, &Year,   1, HAL_MAX_DELAY);
1151:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Month,  1, &Month,  1, HAL_MAX_DELAY);
1152:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Day,    1, &Day,    1, HAL_MAX_DELAY);
1153:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Hour,   1, &Hour,   1, HAL_MAX_DELAY);
1154:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Minute, 1, &Minute, 1, HAL_MAX_DELAY);
1155:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Second, 1, &Second, 1, HAL_MAX_DELAY);
1156:Core/Src/main.c **** 
1157:Core/Src/main.c ****     // Mask status bits BEFORE BCD conversion
1158:Core/Src/main.c ****     Year   = bcdtodec(Year);
1159:Core/Src/main.c ****     Month  = bcdtodec(Month  & 0x1F); // mask century bit
1160:Core/Src/main.c ****     Day    = bcdtodec(Day    & 0x3F);
1161:Core/Src/main.c ****     Hour   = bcdtodec(Hour   & 0x3F); // mask 12/24hr bit
1162:Core/Src/main.c ****     Minute = bcdtodec(Minute & 0x7F);
1163:Core/Src/main.c ****     Second = bcdtodec(Second & 0x7F);
1164:Core/Src/main.c **** 
1165:Core/Src/main.c ****     return get_unix_timestamp(2000 + Year, Month, Day, Hour, Minute, Second);
1166:Core/Src/main.c **** }
1167:Core/Src/main.c **** 
1168:Core/Src/main.c **** static void RTC_Set_Time_Once(I2C_HandleTypeDef *hi2c)
1169:Core/Src/main.c **** {
1170:Core/Src/main.c ****     // Check if time has already been set
1171:Core/Src/main.c ****     uint8_t magic = 0;
1172:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_MAGIC_REG, 1, &magic, 1, HAL_MAX_DELAY);
1173:Core/Src/main.c ****     
1174:Core/Src/main.c ****     if (magic == RTC_MAGIC_VAL)
1175:Core/Src/main.c ****         return; // Already set, skip
1176:Core/Src/main.c **** 
1177:Core/Src/main.c ****     // Parse compile-time strings into numbers
ARM GAS  C:\Users\joabk\AppData\Local\Temp\ccm84pxu.s 			page 31


1178:Core/Src/main.c ****     // __DATE__ is "Mon DD YYYY" e.g. "Apr 22 2026"
1179:Core/Src/main.c ****     // __TIME__ is "HH:MM:SS"   e.g. "14:30:00"
1180:Core/Src/main.c ****     char date[] = __DATE__;
1181:Core/Src/main.c ****     char time[] = __TIME__;
1182:Core/Src/main.c **** 
1183:Core/Src/main.c ****     uint8_t day    = ((date[4] == ' ') ? 0 : (date[4] - '0')) * 10 + (date[5] - '0');
1184:Core/Src/main.c ****     uint16_t year  = (date[7]-'0')*1000 + (date[8]-'0')*100 + (date[9]-'0')*10 + (date[10]-'0');
1185:Core/Src/main.c ****     uint8_t hour   = (time[0]-'0')*10 + (time[1]-'0');
1186:Core/Src/main.c ****     uint8_t minute = (time[3]-'0')*10 + (time[4]-'0');
1187:Core/Src/main.c ****     uint8_t second = (time[6]-'0')*10 + (time[7]-'0');
1188:Core/Src/main.c **** 
1189:Core/Src/main.c ****     // Parse month string
1190:Core/Src/main.c ****     const char *months = "JanFebMarAprMayJunJulAugSepOctNovDec";
1191:Core/Src/main.c ****     uint8_t month = 1;
1192:Core/Src/main.c ****     for (int i = 0; i < 12; i++) {
1193:Core/Src/main.c ****         if (strncmp(&months[i*3], date, 3) == 0) {
1194:Core/Src/main.c ****             month = i + 1;
1195:Core/Src/main.c ****             break;
1196:Core/Src/main.c ****         }
1197:Core/Src/main.c ****     }
1198:Core/Src/main.c **** 
1199:Core/Src/main.c ****     // Write to DS3231 registers in BCD
1200:Core/Src/main.c ****     uint8_t reg_val;
1201:Core/Src/main.c **** 
1202:Core/Src/main.c ****     reg_val = decimalbcd(second);
1203:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Second, 1, &reg_val, 1, HAL_MAX_DELAY);
1204:Core/Src/main.c **** 
1205:Core/Src/main.c ****     reg_val = decimalbcd(minute);
1206:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Minute, 1, &reg_val, 1, HAL_MAX_DELAY);
1207:Core/Src/main.c **** 
1208:Core/Src/main.c ****     reg_val = decimalbcd(hour);
1209:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Hour, 1, &reg_val, 1, HAL_MAX_DELAY);
1210:Core/Src/main.c **** 
1211:Core/Src/main.c ****     reg_val = decimalbcd(day);
1212:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Day, 1, &reg_val, 1, HAL_MAX_DELAY);
1213:Core/Src/main.c **** 
1214:Core/Src/main.c ****     reg_val = decimalbcd(month);
1215:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Month, 1, &reg_val, 1, HAL_MAX_DELAY);
1216:Core/Src/main.c **** 
1217:Core/Src/main.c ****     reg_val = decimalbcd(year % 100); // DS3231 only stores last 2 digits
1218:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_Year, 1, &reg_val, 1, HAL_MAX_DELAY);
1219:Core/Src/main.c **** 
1220:Core/Src/main.c ****     // Write magic flag so we never set time again
1221:Core/Src/main.c ****     reg_val = RTC_MAGIC_VAL;
1222:Core/Src/main.c ****     HAL_I2C_Mem_Write(hi2c, RTC_Addr, RTC_MAGIC_REG, 1, &reg_val, 1, HAL_MAX_DELAY);
1223:Core/Src/main.c **** }
