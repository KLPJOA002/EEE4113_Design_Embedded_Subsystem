1685:Core/Src/main.c **** static uint32_t get_unix_timestamp(uint16_t year, uint8_t month, uint8_t day, 
1686:Core/Src/main.c ****                            uint8_t hour, uint8_t min, uint8_t sec) 
1687:Core/Src/main.c **** {
1688:Core/Src/main.c ****     struct tm t;
1689:Core/Src/main.c ****     time_t t_of_day;
1690:Core/Src/main.c **** 
1691:Core/Src/main.c ****     // Standard C struct tm requirements:
1692:Core/Src/main.c ****     t.tm_year = year - 1900;  // Year since 1900
1693:Core/Src/main.c ****     t.tm_mon = month - 1;     // Month, 0 - 11
1694:Core/Src/main.c ****     t.tm_mday = day;          // Day of the month
1695:Core/Src/main.c ****     t.tm_hour = hour;
1696:Core/Src/main.c ****     t.tm_min = min;
1697:Core/Src/main.c ****     t.tm_sec = sec;
1698:Core/Src/main.c ****     t.tm_isdst = -1;          // Is Daylight Savings Time on? -1 = let the library decide
1699:Core/Src/main.c **** 
1700:Core/Src/main.c ****     t_of_day = mktime(&t);
1701:Core/Src/main.c **** 
1702:Core/Src/main.c ****     return (uint32_t)t_of_day;
1703:Core/Src/main.c **** }
