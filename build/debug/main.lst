 662:Core/Src/main.c ****   SX1278_hw_Reset(&SX1278_hw);   // pulls reset low then high, waits 100ms internally
 663:Core/Src/main.c ****   HAL_Delay(100);
 664:Core/Src/main.c ****   if (LoRa_Detect(&SX1278))
 665:Core/Src/main.c ****   {
 666:Core/Src/main.c ****     SX1278_init(&SX1278, 433175000, SX1278_POWER_11DBM, SX1278_LORA_SF_7,
 667:Core/Src/main.c ****     SX1278_LORA_BW_125KHZ, SX1278_LORA_CR_4_5, SX1278_LORA_CRC_EN, 100);
 668:Core/Src/main.c **** 
 669:Core/Src/main.c ****     LoRa_Connected = 1;
 670:Core/Src/main.c ****     return 1;
 671:Core/Src/main.c ****   }
 672:Core/Src/main.c ****   else
 673:Core/Src/main.c ****   {
 674:Core/Src/main.c ****     LoRa_Connected = 0;
