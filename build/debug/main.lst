 383:Core/Src/main.c ****         case 2:
 384:Core/Src/main.c ****           snprintf(mode_buffer,sizeof(mode_buffer),"TX");
 385:Core/Src/main.c ****           Mode = 0;
 386:Core/Src/main.c ****           Mode_Changed = 1;
 387:Core/Src/main.c ****           break;
 388:Core/Src/main.c ****         case 3:
 389:Core/Src/main.c ****           snprintf(mode_buffer,sizeof(mode_buffer),"ST");
 390:Core/Src/main.c ****           Mode = 0;
 391:Core/Src/main.c ****           Mode_Changed = 1;
 392:Core/Src/main.c ****           break;
 393:Core/Src/main.c ****         default:
