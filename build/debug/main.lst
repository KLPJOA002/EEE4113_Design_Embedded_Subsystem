1489:Core/Src/main.c **** static uint32_t get_unix_timestamp(uint16_t year, uint8_t month, uint8_t day, 
1490:Core/Src/main.c ****                            uint8_t hour, uint8_t min, uint8_t sec) 
1491:Core/Src/main.c **** {
1492:Core/Src/main.c ****     struct tm t;
1493:Core/Src/main.c ****     time_t t_of_day;
1494:Core/Src/main.c **** 
1495:Core/Src/main.c ****     // Standard C struct tm requirements:
1496:Core/Src/main.c ****     t.tm_year = year - 1900;  // Year since 1900
1497:Core/Src/main.c ****     t.tm_mon = month - 1;     // Month, 0 - 11
1498:Core/Src/main.c ****     t.tm_mday = day;          // Day of the month
1499:Core/Src/main.c ****     t.tm_hour = hour;
1500:Core/Src/main.c ****     t.tm_min = min;
1501:Core/Src/main.c ****     t.tm_sec = sec;
1502:Core/Src/main.c ****     t.tm_isdst = -1;          // Is Daylight Savings Time on? -1 = let the library decide
1503:Core/Src/main.c **** 
1504:Core/Src/main.c ****     t_of_day = mktime(&t);
1505:Core/Src/main.c **** 
1506:Core/Src/main.c ****     return (uint32_t)t_of_day;
1507:Core/Src/main.c **** }
