1979:Core/Src/main.c **** static uint32_t ADC_ReadRaw_Averaged(void)
1980:Core/Src/main.c **** {
1981:Core/Src/main.c ****     uint32_t accumulator = 0;
1982:Core/Src/main.c ****     for (uint8_t i = 0; i < ADC_NUM_SAMPLES; i++)
1983:Core/Src/main.c ****     {
1984:Core/Src/main.c ****         HAL_ADC_Start(&hadc1);
1985:Core/Src/main.c ****         if (HAL_ADC_PollForConversion(&hadc1, 10) == HAL_OK)
1986:Core/Src/main.c ****             accumulator += HAL_ADC_GetValue(&hadc1);
1987:Core/Src/main.c ****         HAL_ADC_Stop(&hadc1);
1988:Core/Src/main.c ****     }
1989:Core/Src/main.c ****     return accumulator / ADC_NUM_SAMPLES;
1990:Core/Src/main.c **** }
1991:Core/Src/main.c **** 
1992:Core/Src/main.c **** static float ADC_RawToMillivolts(uint32_t raw)
1993:Core/Src/main.c **** {
1994:Core/Src/main.c ****     return ((float)raw / ADC_RESOLUTION) * VREF_MV;
1995:Core/Src/main.c **** }
1996:Core/Src/main.c **** 
1997:Core/Src/main.c **** static float ADC_CalculateSoCPercent(float voltage_mv)
1998:Core/Src/main.c **** {
1999:Core/Src/main.c ****     if (voltage_mv >= SOC_FULL_MV)  return 100.0f;
2000:Core/Src/main.c ****     if (voltage_mv <= SOC_EMPTY_MV) return   0.0f;
2001:Core/Src/main.c ****     return ((voltage_mv - SOC_EMPTY_MV) /
2002:Core/Src/main.c ****             (SOC_FULL_MV - SOC_EMPTY_MV)) * 100.0f;
2003:Core/Src/main.c **** }
