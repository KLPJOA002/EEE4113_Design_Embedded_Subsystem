1175:Core/Src/main.c **** static uint32_t RTC_Get_Time(I2C_HandleTypeDef *hi2c)
1176:Core/Src/main.c **** {
1177:Core/Src/main.c ****     uint8_t Year, Month, Day, Hour, Minute, Second;
ARM GAS  C:\Users\joabk\AppData\Local\Temp\ccpTartM.s 			page 31


1178:Core/Src/main.c **** 
1179:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Year,   1, &Year,   1, HAL_MAX_DELAY);
1180:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Month,  1, &Month,  1, HAL_MAX_DELAY);
1181:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Day,    1, &Day,    1, HAL_MAX_DELAY);
1182:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Hour,   1, &Hour,   1, HAL_MAX_DELAY);
1183:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Minute, 1, &Minute, 1, HAL_MAX_DELAY);
1184:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Second, 1, &Second, 1, HAL_MAX_DELAY);
1185:Core/Src/main.c **** 
1186:Core/Src/main.c ****     // Mask status bits BEFORE BCD conversion
1187:Core/Src/main.c ****     Year   = bcdtodec(Year);
1188:Core/Src/main.c ****     Month  = bcdtodec(Month  & 0x1F); // mask century bit
1189:Core/Src/main.c ****     Day    = bcdtodec(Day    & 0x3F);
1190:Core/Src/main.c ****     Hour   = bcdtodec(Hour   & 0x3F); // mask 12/24hr bit
1191:Core/Src/main.c ****     Minute = bcdtodec(Minute & 0x7F);
1192:Core/Src/main.c ****     Second = bcdtodec(Second & 0x7F);
1193:Core/Src/main.c **** 
1194:Core/Src/main.c ****     return get_unix_timestamp(2000 + Year, Month, Day, Hour, Minute, Second);
1195:Core/Src/main.c **** }
