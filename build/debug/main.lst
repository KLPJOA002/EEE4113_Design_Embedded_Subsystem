 693:Core/Src/main.c **** // Lora Functions
 694:Core/Src/main.c **** // ===============================================================================================
 695:Core/Src/main.c **** uint8_t LoRa_Init()
 696:Core/Src/main.c **** {
 697:Core/Src/main.c **** 
 698:Core/Src/main.c ****   SX1278_hw_init(&SX1278_hw);
 699:Core/Src/main.c **** 
 700:Core/Src/main.c ****   // Step 2: perform a hard reset and wait for module to boot
 701:Core/Src/main.c ****   SX1278_hw_Reset(&SX1278_hw);   // pulls reset low then high, waits 100ms internally
 702:Core/Src/main.c ****   HAL_Delay(100);
 703:Core/Src/main.c ****   if (LoRa_Detect(&SX1278))
 704:Core/Src/main.c ****   {
 705:Core/Src/main.c ****     SX1278_init(&SX1278, 433175000, SX1278_POWER_11DBM, SX1278_LORA_SF_7,
 706:Core/Src/main.c ****     SX1278_LORA_BW_125KHZ, SX1278_LORA_CR_4_5, SX1278_LORA_CRC_EN, 100);
 707:Core/Src/main.c **** 
 708:Core/Src/main.c ****     LoRa_ArmRX();
 709:Core/Src/main.c **** 
 710:Core/Src/main.c ****     LoRa_Connected = 1;
 711:Core/Src/main.c ****     return 1;
 712:Core/Src/main.c ****   }
 713:Core/Src/main.c ****   else
 714:Core/Src/main.c ****   {
ARM GAS  C:\Users\joabk\AppData\Local\Temp\cctYVfAK.s 			page 14


 715:Core/Src/main.c ****     LoRa_Connected = 0;
 716:Core/Src/main.c ****     return 0;
 717:Core/Src/main.c ****   }
 718:Core/Src/main.c **** }
 719:Core/Src/main.c **** 
 720:Core/Src/main.c **** uint8_t LoRa_Detect(SX1278_t *module)
 721:Core/Src/main.c **** {
 722:Core/Src/main.c ****   uint8_t version = SX1278_SPIRead(module, REG_LR_VERSION);
 723:Core/Src/main.c ****   return (version == 0x12) ? 1 : 0;
 724:Core/Src/main.c **** }
 725:Core/Src/main.c **** 
 726:Core/Src/main.c **** 
 727:Core/Src/main.c **** uint8_t LoRa_TX(char *message)
 728:Core/Src/main.c **** {
 729:Core/Src/main.c ****   uint8_t msg_len = strlen(message);
 730:Core/Src/main.c ****   if (msg_len == 0 || msg_len > 50) return 0;
 731:Core/Src/main.c **** 
 732:Core/Src/main.c ****   if (SX1278_LoRaEntryTx(&SX1278, msg_len, 2000))
 733:Core/Src/main.c ****   {
 734:Core/Src/main.c ****     uint8_t result =  SX1278_LoRaTxPacket(&SX1278, (uint8_t*)message, msg_len, 2000);
 735:Core/Src/main.c ****     LoRa_ArmRX();
