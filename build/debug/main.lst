1678:Core/Src/main.c ****             if (!col1 || !col2 || !col3) continue;
1679:Core/Src/main.c **** 
1680:Core/Src/main.c ****             // Capture timestamp from first row (all rows share same timestamp)
1681:Core/Src/main.c ****             if (ts[0] == '\0') strncpy(ts, col1, sizeof(ts)-1);
1682:Core/Src/main.c **** 
