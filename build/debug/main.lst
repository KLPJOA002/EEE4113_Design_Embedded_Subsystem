 748:Core/Src/main.c **** static uint32_t RTC_Get_Time(I2C_HandleTypeDef *hi2c)
 749:Core/Src/main.c **** {
 750:Core/Src/main.c ****     uint8_t Year, Month, Day, Hour, Minute, Second;
 751:Core/Src/main.c **** 
 752:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Year,   1, &Year,   1, HAL_MAX_DELAY);
 753:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Month,  1, &Month,  1, HAL_MAX_DELAY);
 754:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Day,    1, &Day,    1, HAL_MAX_DELAY);
 755:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Hour,   1, &Hour,   1, HAL_MAX_DELAY);
 756:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Minute, 1, &Minute, 1, HAL_MAX_DELAY);
 757:Core/Src/main.c ****     HAL_I2C_Mem_Read(hi2c, RTC_Addr, RTC_Second, 1, &Second, 1, HAL_MAX_DELAY);
 758:Core/Src/main.c **** 
 759:Core/Src/main.c ****     // Mask status bits BEFORE BCD conversion
 760:Core/Src/main.c ****     Year   = bcdtodec(Year);
 761:Core/Src/main.c ****     Month  = bcdtodec(Month  & 0x1F); // mask century bit
 762:Core/Src/main.c ****     Day    = bcdtodec(Day    & 0x3F);
 763:Core/Src/main.c ****     Hour   = bcdtodec(Hour   & 0x3F); // mask 12/24hr bit
 764:Core/Src/main.c ****     Minute = bcdtodec(Minute & 0x7F);
 765:Core/Src/main.c ****     Second = bcdtodec(Second & 0x7F);
 766:Core/Src/main.c **** 
 767:Core/Src/main.c ****     return get_unix_timestamp(2000 + Year, Month, Day, Hour, Minute, Second);
 768:Core/Src/main.c **** }
