1776:Core/Src/main.c ****     
1777:Core/Src/main.c ****     if (magic == RTC_MAGIC_VAL)
1778:Core/Src/main.c ****         return; // Already set, skip
1779:Core/Src/main.c **** 
1780:Core/Src/main.c ****     // Parse compile-time strings into numbers
1781:Core/Src/main.c ****     // __DATE__ is "Mon DD YYYY" e.g. "Apr 22 2026"
1782:Core/Src/main.c ****     // __TIME__ is "HH:MM:SS"   e.g. "14:30:00"
1783:Core/Src/main.c ****     char date[] = __DATE__;
1784:Core/Src/main.c ****     char time[] = __TIME__;
1785:Core/Src/main.c **** 
1786:Core/Src/main.c ****     uint8_t day    = ((date[4] == ' ') ? 0 : (date[4] - '0')) * 10 + (date[5] - '0');
1787:Core/Src/main.c ****     uint16_t year  = (date[7]-'0')*1000 + (date[8]-'0')*100 + (date[9]-'0')*10 + (date[10]-'0');
1788:Core/Src/main.c ****     uint8_t hour   = (time[0]-'0')*10 + (time[1]-'0');
1789:Core/Src/main.c ****     uint8_t minute = (time[3]-'0')*10 + (time[4]-'0');
1790:Core/Src/main.c ****     uint8_t second = (time[6]-'0')*10 + (time[7]-'0');
1791:Core/Src/main.c **** 
1792:Core/Src/main.c ****     // Parse month string
1793:Core/Src/main.c ****     const char *months = "JanFebMarAprMayJunJulAugSepOctNovDec";
1794:Core/Src/main.c ****     uint8_t month = 1;
