1257:Core/Src/main.c **** uint8_t LoRa_TX_Continuous(const char *message)
1258:Core/Src/main.c **** {
1259:Core/Src/main.c ****     uint8_t msg_len = strlen(message);
1260:Core/Src/main.c ****     if (msg_len == 0 || msg_len > 100) return 0;
1261:Core/Src/main.c **** 
1262:Core/Src/main.c ****     // Lightweight TX setup — no SX1278_config, no 15ms delay
1263:Core/Src/main.c ****     SX1278_SPIWrite(&SX1278, REG_LR_PADAC,        0x87);  // PA boost
1264:Core/Src/main.c ****     SX1278_SPIWrite(&SX1278, LR_RegHopPeriod,     0x00);
1265:Core/Src/main.c ****     SX1278_SPIWrite(&SX1278, REG_LR_DIOMAPPING1,  0x41);  // DIO0 = TxDone
1266:Core/Src/main.c ****     SX1278_clearLoRaIrq(&SX1278);
1267:Core/Src/main.c ****     SX1278_SPIWrite(&SX1278, LR_RegIrqFlagsMask,  0xF7);
1268:Core/Src/main.c ****     SX1278_SPIWrite(&SX1278, LR_RegPayloadLength,  msg_len);
1269:Core/Src/main.c **** 
1270:Core/Src/main.c ****     uint8_t addr = SX1278_SPIRead(&SX1278, LR_RegFifoTxBaseAddr);
1271:Core/Src/main.c ****     SX1278_SPIWrite(&SX1278, LR_RegFifoAddrPtr, addr);
1272:Core/Src/main.c **** 
1273:Core/Src/main.c ****     SX1278.status = TX;  // set before firing so EXTI handler ignores DIO0
1274:Core/Src/main.c **** 
1275:Core/Src/main.c ****     // Write payload and fire
1276:Core/Src/main.c ****     SX1278_SPIBurstWrite(&SX1278, 0x00, (uint8_t*)message, msg_len);
1277:Core/Src/main.c ****     SX1278_SPIWrite(&SX1278, LR_RegOpMode, 0x8B);  // TX mode
1278:Core/Src/main.c **** 
1279:Core/Src/main.c ****     // Poll for TxDone
1280:Core/Src/main.c ****     uint32_t deadline = HAL_GetTick() + 3000;
1281:Core/Src/main.c ****     while (!SX1278_hw_GetDIO0(SX1278.hw))
1282:Core/Src/main.c ****     {
1283:Core/Src/main.c ****         if (HAL_GetTick() > deadline) return 0;
1284:Core/Src/main.c ****     }
