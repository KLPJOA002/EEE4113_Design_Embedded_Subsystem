  57:Core/Src/SX1278.c **** void SX1278_config(SX1278_t *module) {
  58:Core/Src/SX1278.c **** 	SX1278_sleep(module); //Change modem mode Must in Sleep mode
  59:Core/Src/SX1278.c **** 	SX1278_hw_DelayMs(15);
