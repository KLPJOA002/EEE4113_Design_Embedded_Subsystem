  72:Core/Src/SX1278.c **** 
  73:Core/Src/SX1278.c **** 	//setting base parameter
  74:Core/Src/SX1278.c **** 	SX1278_SPIWrite(module, LR_RegPaConfig, SX1278_Power[module->power]); //Setting output power param
  75:Core/Src/SX1278.c **** 
  76:Core/Src/SX1278.c **** 	SX1278_SPIWrite(module, LR_RegOcp, 0x0B);			//RegOcp,Close Ocp
  77:Core/Src/SX1278.c **** 	SX1278_SPIWrite(module, LR_RegLna, 0x23);		//RegLNA,High & LNA Enable
